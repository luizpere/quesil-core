<!-- === FUNÇÕES DOCK GARANTIDAS === -->
<script>
window.openEditor = function() {
    console.log('📝 [EDITOR] Abrindo...');
    window.location.href = '/editor';
};

window.openTerminalWeb = function() {
    console.log('⌨️ [TERMINAL] Abrindo...');
    if (typeof window.openSafeTerminal === 'function') {
        window.openSafeTerminal();
    } else {
        alert('Terminal Web está carregando. Aguarde alguns segundos e tente novamente.');
    }
};
console.log('✅ [DOCK] Funções globais carregadas');
</script>

<!-- === CORREÇÕES DOCK E BUSCA === -->
<script>
// 1. Funções do Dock
window.openSettings = window.openSettings || function() { 
    console.log('️ Abrindo Configurações...');
    window.location.href = '/configuracoes'; 
};

window.openThinkinBrowser = window.openThinkinBrowser || function() { 
    console.log('🌐 Abrindo Navegador...');
    var cards = document.querySelectorAll('.card');
    for(var i=0; i<cards.length; i++) {
        if(cards[i].innerText.includes('Browser')) {
            cards[i].click();
            return;
        }
    }
    window.location.href = '/browser';
};

console.log('✅ Funções Dock definidas');

// 2. Barra de Busca
(function() {
    function initSearch() {
        var container = document.getElementById('assistants-container');
        if (!container || document.getElementById('search-input-final')) return;
        
        var input = document.createElement('input');
        input.type = 'text';
        input.id = 'search-input-final';
        input.placeholder = '🔍 Buscar assistentes... (Ctrl+K)';
        input.autocomplete = 'off';
        input.style.cssText = 'grid-column: 1 / -1; width: 100%; max-width: 100%; padding: 14px 24px; margin-bottom: 20px; border-radius: 30px; border: 2px solid #444; background: #1a1a1a; color: #fff; font-size: 1.05em; outline: none; box-sizing: border-box; display: block;';
        
        if (container.firstChild) {
            container.insertBefore(input, container.firstChild);
        } else {
            container.appendChild(input);
        }
        
        input.addEventListener('input', function() {
            var q = this.value.toLowerCase().trim();
            container.querySelectorAll('.card').forEach(function(card) {
                if (card.id === 'system-metrics-card') return;
                card.style.display = (q === '' || card.innerText.toLowerCase().includes(q)) ? '' : 'none';
            });
        });
        
        document.addEventListener('keydown', function(e) {
            if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
                e.preventDefault();
                input.focus();
                input.select();
            }
        });
        
        console.log('✅ Busca injetada no topo do grid');
    }
    
    setTimeout(initSearch, 500);
})();
</script>
<!-- === FIM CORREÇÕES === -->
<script>
(function() {
    console.log(' Sistema de Tema Desktop carregado');
    
    function applyTheme(color) {
        console.log('🎨 Aplicando tema:', color);
        
        var h1s = document.querySelectorAll('h1');
        h1s.forEach(function(h1) {
            if (h1.innerText.includes('ThinkinOS')) {
                h1.style.color = color;
                h1.style.textShadow = '0 0 20px ' + color + '40';
            }
        });
        
        var cards = document.querySelectorAll('.card');
        cards.forEach(function(card) {
            card.style.borderLeft = '4px solid ' + color;
card.style.borderTop = 'none';
card.style.borderRight = 'none';
card.style.borderBottom = 'none';

            card.style.boxShadow = '0 4px 15px ' + color + '20';
        });
        
        console.log('✅ ' + cards.length + ' cards atualizados');
        
        var style = document.getElementById('theme-style');
        if (!style) {
            style = document.createElement('style');
            style.id = 'theme-style';
            document.head.appendChild(style);
        }
        
        style.textContent = 'h1 { color: ' + color + ' !important; } .card { border: 2px solid ' + color + '40 !important; } :root { --primary-color: ' + color + ' !important; }';
    }
    
    var savedColor = localStorage.getItem('theme-color');
    if (savedColor) {
        console.log('🎨 Tema salvo:', savedColor);
        setTimeout(function() { applyTheme(savedColor); }, 500);
    }
    
    console.log('✅ Sistema de Tema Desktop inicializado');
})();

// Alias para compatibilidade
window.openFM = openFileManager;
</script>

<!-- === FILE MANAGER v9.0 === -->
<script>
// Variáveis globais do FM
var fmCurrentView = 'grid';
var fmAllFiles = [];
var fmSelectedFile = null;

// Função principal para abrir o modal
function openFileManager() {
    console.log('🚀 openFileManager() v9.0 chamado');
    var overlay = document.getElementById('fm-overlay');
    var modal = document.getElementById('fm-modal');
    
    if (overlay) overlay.classList.add('active');
    if (modal) modal.classList.add('active');
    
    loadFMFiles();
}

// Fechar o modal
function closeFileManager() {
    var overlay = document.getElementById('fm-overlay');
    var modal = document.getElementById('fm-modal');
    
    if (overlay) overlay.classList.remove('active');
    if (modal) modal.classList.remove('active');
    fmSelectedFile = null;
}

// Carregar arquivos da API
function loadFMFiles() {
    console.log('📡 loadFMFiles() chamado');
    
    var loading = document.getElementById('fm-loading');
    var empty = document.getElementById('fm-empty');
    var grid = document.getElementById('fm-grid');
    var list = document.getElementById('fm-list');

    if (loading) loading.style.display = 'block';
    if (empty) empty.style.display = 'none';
    if (grid) grid.style.display = 'none';
    if (list) list.style.display = 'none';

    fetch('/api/files/list')
        .then(function(res) {
            console.log('📡 Status:', res.status);
            return res.json();
        })
        .then(function(data) {
            console.log('📦 Dados recebidos:', data);
            
            var filesArray = [];
            if (Array.isArray(data)) {
                filesArray = data;
            } else if (data && Array.isArray(data.files)) {
                filesArray = data.files;
            }

            console.log('📊 Total de arquivos:', filesArray.length);

            if (filesArray.length > 0) {
                fmAllFiles = filesArray;
                renderFMFiles();
            } else {
                if (empty) empty.style.display = 'block';
            }
        })
        .catch(function(err) {
            console.error(' Erro ao carregar arquivos:', err);
            if (empty) empty.style.display = 'block';
        })
        .finally(function() {
            if (loading) loading.style.display = 'none';
        });
}

// Renderizar arquivos na tela
function renderFMFiles() {
    console.log(' renderFMFiles() chamado, view:', fmCurrentView);
    
    var grid = document.getElementById('fm-grid');
    var list = document.getElementById('fm-list');
    var empty = document.getElementById('fm-empty');

    if (fmAllFiles.length === 0) {
        if (empty) empty.style.display = 'block';
        return;
    }
    if (empty) empty.style.display = 'none';

    if (fmCurrentView === 'grid') {
        if (grid) {
            grid.style.display = 'grid';
            var html = '';
            fmAllFiles.forEach(function(file) {
                html += '<div class="fm-file-card" onclick="selectFMFile(this, '' + file.name.replace(/'/g, "\'") + '')">';
                html += '<div class="fm-file-icon">' + getFMFileIcon(file.name) + '</div>';
                html += '<div class="fm-file-name">' + file.name + '</div>';
                html += '</div>';
            });
            grid.innerHTML = html;
        }
        if (list) list.style.display = 'none';
    } else {
        if (list) {
            list.style.display = 'flex';
            var html = '';
            fmAllFiles.forEach(function(file) {
                html += '<div class="fm-list-item" onclick="selectFMFile(this, '' + file.name.replace(/'/g, "\'") + '')">';
                html += '<div class="fm-list-icon">' + getFMFileIcon(file.name) + '</div>';
                html += '<div class="fm-list-name">' + file.name + '</div>';
                html += '<div class="fm-list-size">' + formatFMSize(file.size) + '</div>';
                html += '</div>';
            });
            list.innerHTML = html;
        }
        if (grid) grid.style.display = 'none';
    }

    var statusCount = document.getElementById('fm-status-count');
    if (statusCount) statusCount.textContent = fmAllFiles.length + ' itens';
}

// Alternar entre Grade e Lista
function toggleFMView(view) {
    fmCurrentView = view;
    var statusView = document.getElementById('fm-status-view');
    if (statusView) statusView.textContent = view === 'grid' ? 'Grade' : 'Lista';
    renderFMFiles();
}

// Selecionar arquivo
function selectFMFile(element, filename) {
    var cards = document.querySelectorAll('.fm-file-card, .fm-list-item');
    for (var i = 0; i < cards.length; i++) {
        cards[i].classList.remove('selected');
    }
    element.classList.add('selected');
    fmSelectedFile = filename;
}

// Obter ícone do arquivo
function getFMFileIcon(filename) {
    var ext = filename.split('.').pop().toLowerCase();
    if (['jpg', 'jpeg', 'png', 'gif', 'svg'].indexOf(ext) !== -1) return '🖼️';
    if (ext === 'pdf') return '📕';
    if (ext === 'doc' || ext === 'docx') return '📘';
    if (ext === 'odt') return '📗';
    if (ext === 'py') return '';
    if (ext === 'js') return '⚡';
    if (ext === 'html') return '🌐';
    if (ext === 'css') return '🎨';
    if (ext === 'json') return '';
    if (ext === 'md') return '📝';
    return '';
}

// Formatar tamanho
function formatFMSize(bytes) {
    if (!bytes) return '-';
    var sizes = ['B', 'KB', 'MB', 'GB'];
    var i = Math.floor(Math.log(bytes) / Math.log(1024));
    return (bytes / Math.pow(1024, i)).toFixed(1) + ' ' + sizes[i];
}

// Upload de arquivos
function handleFMUpload(files) {
    if (!files || files.length === 0) return;
    var formData = new FormData();
    for (var i = 0; i < files.length; i++) {
        formData.append('files', files[i]);
    }
    
    var loading = document.getElementById('fm-loading');
    if (loading) {
        loading.style.display = 'block';
        loading.textContent = 'Enviando ' + files.length + ' arquivo(s)...';
    }

    fetch('/api/files/upload', { method: 'POST', body: formData })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data.success) {
                alert(files.length + ' arquivo(s) enviado(s) com sucesso!');
                loadFMFiles();
            } else {
                alert('Erro: ' + (data.error || 'Falha no upload'));
            }
        })
        .catch(function(err) {
            alert('Erro de conexão: ' + err.message);
        })
        .finally(function() {
            if (loading) {
                loading.style.display = 'none';
                loading.textContent = 'Carregando arquivos...';
            }
        });
}

// Criar nova pasta
function showNewFMFolderModal() {
    var name = prompt('Nome da nova pasta:');
    if (name) {
        fetch('/api/files/create', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ name: name, type: 'folder' })
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data.success) {
                alert('Pasta criada com sucesso!');
                loadFMFiles();
            } else {
                alert('Erro: ' + (data.error || 'Falha ao criar pasta'));
            }
        });
    }
}

// Criar novo arquivo
function showNewFMFileModal() {
    var name = prompt('Nome do novo arquivo:');
    if (name) {
        fetch('/api/files/create', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ name: name, type: 'file', content: '' })
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data.success) {
                alert('Arquivo criado com sucesso!');
                loadFMFiles();
            } else {
                alert('Erro: ' + (data.error || 'Falha ao criar arquivo'));
            }
        });
    }
}

// Excluir arquivo
function deleteFMFile() {
    if (!fmSelectedFile) {
        alert('Selecione um arquivo para excluir.');
        return;
    }
    if (confirm('Tem certeza que deseja excluir "' + fmSelectedFile + '"?')) {
        fetch('/api/files/delete/' + encodeURIComponent(fmSelectedFile), { method: 'DELETE' })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data.success) {
                alert('Arquivo excluído com sucesso!');
                fmSelectedFile = null;
                loadFMFiles();
            } else {
                alert('Erro: ' + (data.error || 'Falha ao excluir'));
            }
        });
    }
}

// Alias para compatibilidade com código antigo
window.openFM = openFileManager;

console.log('✅ File Manager v9.0 carregado com sucesso!');
</script>

<script src="/static/fm-v9.js"></script>
<!-- === FILE MANAGER v9.0 MODAL === -->
<div class="fm-overlay" id="fm-overlay" onclick="closeFileManager()"></div>
