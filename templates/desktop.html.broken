            <div style="font-size: 10px; color: #888; margin-top: 3px;">USUÁRIOS</div>
        </div>
        <div style="background: rgba(255,170,0,0.08); padding: 12px; border-radius: 8px; text-align: center; border: 1px solid rgba(255,170,0,0.2);">
