        /* TEMA NEON - Rosa e Azul Vibrante */
        body.theme-neon { background: #0d0221; color: #ff6ec7; font-family: 'Segoe UI', sans-serif; }
        body.theme-neon .sidebar { background: #150734; border-right: 2px solid #ff6ec7; box-shadow: 0 0 30px rgba(255,110,199,0.4); }
        body.theme-neon .sidebar-header h2 { color: #ff6ec7; text-shadow: 0 0 15px #ff6ec7; }
        body.theme-neon .assistente-card { background: #1a0b3d; border: 1px solid #00d9ff; box-shadow: 0 0 10px rgba(0,217,255,0.2); }
        body.theme-neon .assistente-card:hover { background: #2a1b5d; box-shadow: 0 0 20px rgba(255,110,199,0.5); }
        body.theme-neon .assistente-card.active { background: linear-gradient(135deg, #ff6ec7, #00d9ff); color: white; }
        body.theme-neon .assistente-card.active h3, body.theme-neon .assistente-card.active p { color: white; text-shadow: 0 0 5px rgba(255,255,255,0.5); }
        body.theme-neon .chat-container { background: #150734; border: 2px solid #00d9ff; box-shadow: 0 0 25px rgba(0,217,255,0.3); }
        body.theme-neon .message.user { background: linear-gradient(135deg, #ff6ec7, #ff00aa); color: white; box-shadow: 0 0 15px rgba(255,110,199,0.6); }
        body.theme-neon .message.assistant { background: #1a0b3d; border: 1px solid #00d9ff; color: #00d9ff; }
        body.theme-neon .input-area input { background: #1a0b3d; border: 2px solid #00d9ff; color: #00d9ff; }
        body.theme-neon .input-area button { background: linear-gradient(135deg, #ff6ec7, #00d9ff); color: white; box-shadow: 0 0 15px rgba(255,110,199,0.5); }
        body.theme-neon .header-btn { background: #1a0b3d; color: #ff6ec7; border: 1px solid #ff6ec7; }
        body.theme-neon .dashboard-btn { background: linear-gradient(135deg, #ff6ec7, #00d9ff); color: white; }
        body.theme-neon .search-bar input { background: #1a0b3d; border: 1px solid #00d9ff; color: #00d9ff; }

