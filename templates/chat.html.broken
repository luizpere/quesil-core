<style>
/* === TEMAS FUNCIONAIS (6) === */

/* DARK */
body.dark {
    background: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 100%);
    color: #e0e0e0;
}
body.dark .sidebar, body.dark .main-content, body.dark .chat-container,
body.dark .message-box, body.dark .assistant-card, body.dark .memory-item,
body.dark input, body.dark textarea, body.dark select {
    background: rgba(26, 26, 46, 0.95);
    color: #e0e0e0;
    border: 1px solid rgba(98, 0, 234, 0.3);
}

/* LIGHT */
body.light {
    background: linear-gradient(135deg, #f5f5f5 0%, #ffffff 100%);
    color: #333;
}
body.light .sidebar, body.light .main-content, body.light .chat-container,
body.light .message-box, body.light .assistant-card, body.light .memory-item,
body.light input, body.light textarea, body.light select {
    background: rgba(255, 255, 255, 0.95);
    color: #333;
    border: 1px solid rgba(0, 0, 0, 0.1);
}

/* BLUE */
body.blue {
    background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
    color: #e0e0e0;
}
body.blue .sidebar, body.blue .main-content, body.blue .chat-container,
body.blue .message-box, body.blue .assistant-card, body.blue .memory-item,
body.blue input, body.blue textarea, body.blue select {
    background: rgba(30, 60, 114, 0.9);
    color: #e0e0e0;
    border: 1px solid rgba(42, 82, 152, 0.5);
}

/* GREEN */
body.green {
    background: linear-gradient(135deg, #134e5e 0%, #71b280 100%);
    color: #e0e0e0;
}
body.green .sidebar, body.green .main-content, body.green .chat-container,
body.green .message-box, body.green .assistant-card, body.green .memory-item,
body.green input, body.green textarea, body.green select {
    background: rgba(19, 78, 94, 0.9);
    color: #e0e0e0;
    border: 1px solid rgba(113, 178, 128, 0.5);
}

/* PURPLE */
body.purple {
    background: linear-gradient(135deg, #3a1c71 0%, #d76d77 50%, #ffaf7b 100%);
    color: #e0e0e0;
}
body.purple .sidebar, body.purple .main-content, body.purple .chat-container,
body.purple .message-box, body.purple .assistant-card, body.purple .memory-item,
body.purple input, body.purple textarea, body.purple select {
    background: rgba(58, 28, 113, 0.9);
    color: #e0e0e0;
    border: 1px solid rgba(215, 109, 119, 0.5);
}

/* NEON */
body.neon {
    background: linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
    color: #00ffff;
}
body.neon .sidebar, body.neon .main-content, body.neon .chat-container,
body.neon .message-box, body.neon .assistant-card, body.neon .memory-item,
body.neon input, body.neon textarea, body.neon select {
    background: rgba(15, 12, 41, 0.9);
    color: #00ffff;
    border: 2px solid #00ffff;
    box-shadow: 0 0 10px rgba(0, 255, 255, 0.3);
}

/* Transições */
body, .sidebar, .main-content, .chat-container, .message-box,
.assistant-card, .memory-item, input, textarea, select {
    transition: background 0.3s ease, color 0.3s ease, border 0.3s ease;
}

        /* Copyright Responsivo */
        .copyright-footer {
            text-align: center;
            padding: 15px;
            color: #888;
            font-size: 0.85em;
            border-top: 1px solid rgba(255,255,255,0.1);
            margin-top: 20px;
            width: 100%;
        }
        .copyright-footer strong {
            color: #6200ea;
        }
        
        /* Celular */
        @media (max-width: 768px) {
            .copyright-footer {
                font-size: 0.75em;
                padding: 10px;
            }
        }
        
        /* Tablet e Desktop */
        @media (min-width: 769px) {
            .copyright-footer {
                font-size: 0.85em;
                padding: 15px;
            }
        }
        
        /* Tela Grande */
        @media (min-width: 1200px) {
            .copyright-footer {
                position: fixed;
                bottom: 10px;
                right: 20px;
                background: rgba(0, 0, 0, 0.8);
                padding: 10px 20px;
                border-radius: 8px;
                border: 1px solid rgba(255,255,255,0.1);
                backdrop-filter: blur(5px);
                margin: 0;
                max-width: 300px;
            }
        }


        /* === MARKDOWN RENDERING === */
        .message-content h1, .message-content h2, .message-content h3 { margin: 15px 0 10px 0; color: #00bcd4; }
        .message-content h1 { font-size: 1.5em; }
        .message-content h2 { font-size: 1.3em; }
        .message-content h3 { font-size: 1.1em; }
        .message-content p { margin: 10px 0; line-height: 1.6; }
        .message-content ul, .message-content ol { margin: 10px 0; padding-left: 30px; }
        .message-content li { margin: 5px 0; }
        .message-content code { background: rgba(0,0,0,0.3); padding: 2px 6px; border-radius: 4px; font-family: 'Courier New', monospace; font-size: 0.9em; }
        .message-content pre { background: #282c34; padding: 15px; border-radius: 8px; overflow-x: auto; margin: 15px 0; }
        .message-content pre code { background: none; padding: 0; }
        .message-content blockquote { border-left: 3px solid #6200ea; padding-left: 15px; margin: 10px 0; color: #aaa; }
        .message-content strong { color: #fff; font-weight: bold; }
        .message-content em { color: #00bcd4; }
        .message-content a { color: #00bcd4; text-decoration: underline; }
        .message-content table { border-collapse: collapse; margin: 10px 0; width: 100%; }
        .message-content th, .message-content td { border: 1px solid rgba(255,255,255,0.2); padding: 8px; text-align: left; }
        .message-content th { background: rgba(98,0,234,0.2); }
        
        /* === BOTÃO EXPORTAR === */
        .btn-export { background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: white; padding: 8px 15px; border-radius: 20px; cursor: pointer; transition: all 0.3s; font-size: 0.9em; display: inline-flex; align-items: center; gap: 5px; margin-left: 10px; }
        .btn-export:hover { background: rgba(98,0,234,0.3); border-color: #6200ea; transform: translateY(-2px); }

    </style>


<style>
    /* Botão Wiki Amarelo */
