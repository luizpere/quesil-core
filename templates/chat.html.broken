    <!-- Markdown e Syntax Highlighting -->
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/dompurify@3.0.6/dist/purify.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>

</head>
<body>
    <button class="menu-toggle" onclick="toggleSidebar()">☰</button>
    <div class="overlay" id="overlay" onclick="toggleSidebar()"></div>
    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <h2 class="logo-header"><img src="/static/logo-thinkinos.png" alt="ThinkinOS" class="main-logo"></h2>
            <div class="header-buttons">
                <a href="/desktop" class="menu-item">🖥️ Desktop</a>
                <a href="/dashboard" class="dashboard-btn">📊 Dashboard</a>
                <a href="/profile" class="dashboard-btn">👤 Perfil</a>
                <button onclick="abrirModalMemorias()" class="memory-btn">🧠 Memórias <a href="/wiki" class="wiki-btn-amarelo" title="Ajuda e Documentação">❓</a></button>
                <a href="/logout" class="logout-btn">🚪 Sair</a>
                <button class="header-btn export" onclick="exportarConversa()" title="Exportar">📥</button>
                <button class="header-btn delete" onclick="limparTodasConversas()" title="Limpar tudo">🗑️</button>
            </div>
        </div>
        <div class="theme-selector">
        <div class="theme-dot dark active" onclick="setTheme('dark')" title="Escuro"></div>
        <div class="theme-dot light" onclick="setTheme('light')" title="Claro"></div>
        <div class="theme-dot blue" onclick="setTheme('blue')" title="Azul"></div>
        <div class="theme-dot green" onclick="setTheme('green')" title="Verde"></div>
        <div class="theme-dot purple" onclick="setTheme('purple')" title="Roxo"></div>
        <div class="theme-dot neon" onclick="setTheme('neon')" title="Neon"></div>
    </div>
        <div class="search-bar">
            <input type="text" id="searchInput" id="busca-input" placeholder="🔍 Buscar mensagens..." onkeyup="if(event.key==='Enter') buscarMensagens()">
            <div id="searchResults" class="search-results"></div>
        </div>
        {% for id, assistente in assistentes.items() %}
        <div class="assistente-card" onclick="selecionarAssistente('{{ id }}')" id="card-{{ id }}">
            <h3>{{ assistente.nome }}</h3>
            <p>{{ assistente.descricao }}</p>
            <button class="delete-session-btn" onclick="event.stopPropagation(); deletarSessaoDoAssistente('{{ id }}')" title="Deletar conversa">🗑️</button>
        </div>
        {% endfor %}
    </div>
    <div class="main">
        <div class="chat-container" id="chat">
            <h2 style="text-align: center; color: #718096; margin-top: 50px;">Selecione um assistente para começar</h2>
        </div>
        <div class="input-area">
            <input type="file" id="file-input" style="display: none;" accept=".png,.jpg,.jpeg,.gif,.pdf,.txt,.md,.csv">
    <button onclick="document.getElementById('file-input').click()" class="attach-btn" title="Anexar arquivo">📎</button>
     <input type="text" id="mensagem" placeholder="Digite sua mensagem..." onkeypress="if(event.key==='Enter') enviarMensagem()">
            <button onclick="enviarMensagem()" id="btnEnviar" title="Enviar">✈️</button>
        </div>
    </div>
    <script>
    // === MENU SIDEBAR ===
    function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('overlay');
        if (sidebar) sidebar.classList.toggle('open');
        if (overlay) overlay.classList.toggle('show');
    }

    // === ASSISTENTES E CHAT ===
    let currentModel = null;
    let currentSessionId = null;

    function selecionarAssistente(model, el) {
        currentModel = model;
        currentSessionId = null;
        
        // Atualizar visual do assistente selecionado
        document.querySelectorAll('.assistant-card').forEach(c => c.style.opacity = '0.6');
        if (el) el.style.opacity = '1';
        
        const chatArea = document.getElementById('chat');
        if (chatArea) {
            chatArea.innerHTML = '<div style="text-align:center; padding:50px; color:#888;">Conversando com ' + model + '</div>';
        }
        
        // Fecha sidebar no mobile
        if(window.innerWidth <= 768) {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('overlay');
            if (sidebar) sidebar.classList.remove('open');
            if (overlay) overlay.classList.remove('show');
        }
    }

    
    function formatarMarkdown(texto) {
        // Converter markdown básico para HTML
        let html = texto
            // Code blocks ```code```
            .replace(/```([\s\S]*?)```/g, '<pre><code>$1</code></pre>')
            // Inline code `code`
            .replace(/`([^`]+)`/g, '<code>$1</code>')
            // Bold **text**
            .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
            // Italic *text*
            .replace(/\*([^*]+)\*/g, '<em>$1</em>')
            // Line breaks
            .replace(/\n/g, '<br>');
        return html;
    }

    function enviarMensagem() {
        const input = document.getElementById('mensagem');
        const msg = input ? input.value.trim() : '';
        if (!msg || !currentModel) {
            if(!currentModel) alert('Selecione um assistente primeiro!');
            return;
        }
        
        input.value = '';
        const chatArea = document.getElementById('chat');
        if (!chatArea) return;
        
        chatArea.innerHTML += '<div style="margin:10px 0; padding:10px; background:#2d2d2d; border-radius:8px; text-align:right;">Você: ' + msg + '</div>';
        chatArea.scrollTop = chatArea.scrollHeight;

        fetch('/api/chat', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({prompt: msg, model: currentModel, session_id: currentSessionId})
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                currentSessionId = data.session_id;
                const respostaFormatada = formatarMarkdown(data.response);
                chatArea.innerHTML += '<div style="margin:10px 0; padding:10px; background:#1a1a1a; border-radius:8px; border-left:3px solid #6200ea;"><strong>' + data.model + ':</strong><br>' + respostaFormatada + '</div>';
                chatArea.scrollTop = chatArea.scrollHeight;
            } else {
                chatArea.innerHTML += '<div style="color:#ff4444;">Erro: ' + (data.error || 'Falha na conexão') + '</div>';
            }
        })
        .catch(err => {
            chatArea.innerHTML += '<div style="color:#ff4444;">Erro de conexão com o servidor.</div>';
        });
    }

    // Permitir enviar com Enter
    document.addEventListener('DOMContentLoaded', function() {
        const input = document.getElementById('mensagem');
        if(input) {
            input.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') enviarMensagem();
            });
        }
        
        // Botão enviar
        const btn = document.getElementById('btnEnviar');
        if(btn) {
            btn.addEventListener('click', enviarMensagem);
        }
    });

    // === SISTEMA DE MEMÓRIAS ===
    function abrirModalMemorias() {
        const modal = document.getElementById('modal-memorias');
        if (modal) {
            modal.style.display = 'flex';
            carregarMemorias();
        }
        // Fecha sidebar no mobile
        if(window.innerWidth <= 768) {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('overlay');
            if (sidebar) sidebar.classList.remove('open');
            if (overlay) overlay.classList.remove('show');
        }
    }
    
    function fecharModalMemorias() {
        const modal = document.getElementById('modal-memorias');
        if (modal) modal.style.display = 'none';
    }
    
    function carregarMemorias() {
        fetch('/api/memories')
            .then(res => res.json())
            .then(memories => {
                const lista = document.getElementById('lista-memorias');
                if (!lista) return;
                lista.innerHTML = '';
                if (!memories || memories.length === 0) {
                    lista.innerHTML = '<p style="color:#888;">Nenhuma memória salva ainda.</p>';
                } else {
                    memories.forEach(m => {
                        const div = document.createElement('div');
                        div.className = 'memory-item';
                        div.innerHTML = '<span style="flex: 1; word-break: break-word;">' + m.content + '</span><button class="delete-memory-btn" onclick="deletarMemoria(' + m.id + ')" title="Esquecer">🗑️</button>';
                        lista.appendChild(div);
                    });
                }
            })
            .catch(err => console.error('Erro ao carregar memórias:', err));
    }
    
    function salvarMemoria() {
        const input = document.getElementById('memory-input');
        const conteudo = input ? input.value.trim() : '';
        if (!conteudo) return alert('Digite algo na memória!');
        
        const btn = document.getElementById('btn-salvar-memoria');
        if (btn) {
            btn.textContent = 'Salvando...';
            btn.disabled = true;
        }

        fetch('/api/memories', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({content: conteudo})
        })
        .then(res => res.json())
        .then(data => {
            if (btn) { btn.textContent = 'Salvar'; btn.disabled = false; }
            if (data.success) {
                if (input) input.value = '';
                carregarMemorias();
            } else {
                alert('Erro ao salvar: ' + (data.error || ''));
            }
        })
        .catch(err => {
            if (btn) { btn.textContent = 'Salvar'; btn.disabled = false; }
            console.error('Erro:', err);
        });
    }
    
    function deletarMemoria(id) {
        if (!confirm('Tem certeza que deseja que a IA esqueça esta memória?')) return;
        
        fetch('/api/memories/' + id, { method: 'DELETE' })
        .then(res => res.json())
        .then(data => {
            if (data.success) carregarMemorias();
            else alert('Erro ao deletar.');
        })
        .catch(err => console.error('Erro ao deletar:', err));
    }

    // === TEMAS ===
    function setTheme(theme) {
        document.body.className = theme;
        localStorage.setItem('theme', theme);
    }
    
    if (localStorage.getItem('theme')) {
        document.body.className = localStorage.getItem('theme');
    }
</script>

    


<!-- Modal de Memórias -->
<div id="modal-memorias" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.8); z-index:1000; justify-content:center; align-items:center;">
    <div style="background:#1e1e1e; padding:20px; border-radius:12px; width:90%; max-width:500px; max-height:80vh; overflow-y:auto; border:1px solid #444;">
        <h3 style="color:#fff; margin-bottom:15px;"> Memórias de Longo Prazo</h3>
        <p style="color:#aaa; font-size:14px; margin-bottom:15px;">Adicione fatos sobre você. Os assistentes usarão isso para personalizar as respostas.</p>
        
        <div style="display:flex; gap:10px; margin-bottom:20px;">
            <input type="text" id="memory-input" placeholder="Ex: Meu nome é Luiz, sou programador..." style="flex:1; padding:10px; border-radius:8px; border:1px solid #444; background:#2d2d2d; color:#fff;">
            <button onclick="salvarMemoria()" id="btn-salvar-memoria" style="padding:10px 20px; background:#6200ea; color:white; border:none; border-radius:8px; cursor:pointer;">Salvar</button>
        </div>
        
        <div id="lista-memorias" style="color:#e0e0e0;">
            <!-- Memórias carregadas aqui -->
        </div>
        
        <button onclick="fecharModalMemorias()" style="margin-top:20px; width:100%; padding:10px; background:#444; color:white; border:none; border-radius:8px; cursor:pointer;">Fechar</button>
    </div>
</div>


<script>
// === CORREÇÕES DEFINITIVAS DO THINKINOS ===

// 1. FUNÇÃO setTheme (se não existir)
if (typeof setTheme !== 'function') {
    window.setTheme = function(themeName) {
        if (!themeName) return;
        document.body.className = themeName;
        localStorage.setItem('theme', themeName);
        console.log('✅ Tema:', themeName);
    };
}

// 2. Carregar tema ao iniciar
(function() {
    const saved = localStorage.getItem('theme');
    if (saved && typeof setTheme === 'function') {
        document.body.className = saved;
    }
})();

// 3. FUNÇÃO deletarMemoria (corrigida com tratamento de erro)
window.deletarMemoria = function(id) {
    if (!confirm('Tem certeza que deseja deletar esta memória?')) return;
    
    fetch('/api/memories/' + id, { method: 'DELETE' })
    .then(res => {
        if (!res.ok) throw new Error('Status ' + res.status);
        return res.json();
    })
    .then(data => {
        if (data.success) {
            if (typeof carregarMemorias === 'function') carregarMemorias();
            else location.reload();
            console.log('✅ Memória deletada');
        } else {
            alert('Erro: ' + (data.error || 'Não foi possível deletar'));
        }
    })
    .catch(err => {
        console.error('Erro:', err);
        alert('Erro ao deletar. Verifique o console.');
    });
};

// 4. FUNÇÃO deletarSessaoDoAssistente (corrigida)
window.deletarSessaoDoAssistente = function(model, event) {
    if (event) {
        event.stopPropagation();
        event.preventDefault();
    }
    if (!confirm('Deseja apagar toda a conversa com ' + model + '?')) return;
    
    fetch('/api/chat/' + encodeURIComponent(model), { method: 'DELETE' })
    .then(res => {
        if (!res.ok) throw new Error('Status ' + res.status);
        return res.json();
    })
    .then(data => {
        if (data.success) {
            const chat = document.getElementById('chat');
            if (chat) {
                chat.innerHTML = '<div style="text-align:center;padding:50px;color:#888;">✅ Conversa com ' + model + ' apagada.</div>';
            }
            console.log('✅ Conversa apagada:', model);
        }
    })
    .catch(err => {
        console.error('Erro:', err);
        alert('Erro ao apagar conversa');
    });
};

// 5. FUNÇÃO limparTodasConversas (faltava!)
window.limparTodasConversas = function() {
    if (!confirm('Apagar TODAS as conversas? Isso não pode ser desfeito.')) return;
    
    fetch('/api/chat/clear-all', { method: 'DELETE' })
    .then(res => {
        if (!res.ok) throw new Error('Status ' + res.status);
        return res.json();
    })
    .then(data => {
        if (data.success) {
            const chat = document.getElementById('chat');
            if (chat) chat.innerHTML = '<div style="text-align:center;padding:50px;color:#888;">✅ Todas as conversas foram apagadas.</div>';
            alert('Todas as conversas foram apagadas!');
        }
    })
    .catch(err => {
        console.error('Erro:', err);
        alert('Erro ao limpar conversas');
    });
};

// 6. INICIALIZAÇÃO - Conectar temas
document.addEventListener('DOMContentLoaded', function() {
    // Conectar bolinhas de tema
    const themeButtons = document.querySelectorAll('.theme-dot');
    themeButtons.forEach(btn => {
        // Remover onclick inline se existir
        const existingOnclick = btn.getAttribute('onclick');
        if (existingOnclick && existingOnclick.includes('setTheme')) {
            // Manter o onclick inline, está correto
            console.log('✅ Botão de tema com onclick inline');
        } else {
            // Adicionar event listener
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                const theme = this.getAttribute('data-theme') || 
                              this.className.split(' ').find(c => c !== 'theme-dot' && c !== 'active');
                if (theme && typeof setTheme === 'function') {
                    setTheme(theme);
                    themeButtons.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                }
            });
        }
    });
    
    console.log('✅ ThinkinOS corrigido! Temas:', themeButtons.length);
});
</script>


<script>
// Garantir que setTheme seja global
if (typeof window.setTheme !== 'function') {
    window.setTheme = function(themeName) {
        if (!themeName) return;
        document.body.className = themeName;
        localStorage.setItem('theme', themeName);
        console.log('✅ Tema aplicado:', themeName);
    };
}

// Log de debug para temas
document.addEventListener('DOMContentLoaded', function() {
    const themeButtons = document.querySelectorAll('.theme-dot');
    console.log('🎨 Botões de tema encontrados:', themeButtons.length);
    
    themeButtons.forEach(btn => {
        btn.addEventListener('click', function(e) {
            const theme = this.getAttribute('onclick').match(/'([^']+)'/)[1];
            console.log('🎨 Clicou no tema:', theme);
            if (typeof window.setTheme === 'function') {
                window.setTheme(theme);
                console.log('✅ setTheme chamado com sucesso');
            } else {
                console.error('❌ setTheme não é uma função!');
            }
        });
    });
});
</script>


<script>
// === FUNÇÕES DE IMAGEM E UPLOAD ===

// 1. GERAR IMAGEM COM IA
function gerarImagem() {
    const mensagem = document.getElementById('mensagem').value.trim();
    
    if (!mensagem) {
        alert('Digite uma descrição para gerar a imagem!');
        return;
    }
    
    const chat = document.getElementById('chat');
    if (!chat) return;
    
    // Adicionar mensagem do usuário
    chat.innerHTML += '<div style="margin:10px 0;padding:10px;background:#2d2d2d;border-radius:8px;text-align:right;">🎨 Você: ' + mensagem + '</div>';
    chat.scrollTop = chat.scrollHeight;
    
    // Limpar input
    document.getElementById('mensagem').value = '';
    
    // Mostrar loading
    const loadingId = 'img-loading-' + Date.now();
    chat.innerHTML += '<div id="' + loadingId + '" style="margin:10px 0;padding:10px;background:#1a1a1a;border-radius:8px;border-left:3px solid #ff00ff;">🎨 Gerando imagem...</div>';
    chat.scrollTop = chat.scrollHeight;
    
    // Enviar para API
    fetch('/api/gerar-imagem', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({prompt: mensagem})
    })
    .then(res => res.json())
    .then(data => {
        const loading = document.getElementById(loadingId);
        if (loading) loading.remove();
        
        if (data.success) {
            if (data.image_url) {
                chat.innerHTML += '<div class="generated-image-container" style="margin:10px 0;padding:10px;background:#1a1a1a;border-radius:8px;border-left:3px solid #ff00ff;"><strong>🎨 Imagem Gerada:</strong><br><img src="' + data.image_url + '" style="max-width:100%;border-radius:8px;margin-top:10px;" alt="Imagem gerada"></div>';
            } else {
                chat.innerHTML += '<div style="margin:10px 0;padding:10px;background:#1a1a1a;border-radius:8px;border-left:3px solid #ff00ff;"><strong>🎨 Resposta:</strong><br>' + (data.message || 'Imagem processada') + '</div>';
            }
        } else {
            chat.innerHTML += '<div style="color:#f44;margin:10px 0;padding:10px;background:#1a1a1a;border-radius:8px;">❌ Erro ao gerar imagem: ' + (data.error || 'Desconhecido') + '</div>';
        }
        chat.scrollTop = chat.scrollHeight;
    })
    .catch(err => {
        const loading = document.getElementById(loadingId);
        if (loading) loading.remove();
        chat.innerHTML += '<div style="color:#f44;margin:10px 0;padding:10px;background:#1a1a1a;border-radius:8px;">❌ Erro de conexão ao gerar imagem</div>';
        chat.scrollTop = chat.scrollHeight;
    });
}

// 2. UPLOAD DE ARQUIVO
document.addEventListener('DOMContentLoaded', function() {
    const fileInput = document.getElementById('file-input');
    if (fileInput) {
        fileInput.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (!file) return;
            
            const formData = new FormData();
            formData.append('file', file);
            
            const chat = document.getElementById('chat');
            if (!chat) return;
            
            // Mostrar loading
            const loadingId = 'upload-loading-' + Date.now();
            chat.innerHTML += '<div id="' + loadingId + '" style="margin:10px 0;padding:10px;background:#1a1a1a;border-radius:8px;border-left:3px solid #00bcd4;">📎 Enviando arquivo: ' + file.name + '...</div>';
            chat.scrollTop = chat.scrollHeight;
            
            // Enviar arquivo
            fetch('/upload', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                const loading = document.getElementById(loadingId);
                if (loading) loading.remove();
                
                if (data.success || data.message) {
                    const analysis = data.analysis_formatado || data.analysis || data.message || 'Arquivo processado';
                    chat.innerHTML += '<div style="margin:10px 0;padding:15px;background:#1a1a1a;border-radius:8px;border-left:3px solid #00bcd4;line-height:1.6;"><strong>📎 Arquivo analisado:</strong><br><div style="margin-top:10px;">' + analysis + '</div></div>';
                } else {
                    chat.innerHTML += '<div style="color:#f44;margin:10px 0;padding:10px;background:#1a1a1a;border-radius:8px;"> Erro ao processar arquivo: ' + (data.error || 'Desconhecido') + '</div>';
                }
                chat.scrollTop = chat.scrollHeight;
            })
            .catch(err => {
                const loading = document.getElementById(loadingId);
                if (loading) loading.remove();
                chat.innerHTML += '<div style="color:#f44;margin:10px 0;padding:10px;background:#1a1a1a;border-radius:8px;">❌ Erro de conexão ao enviar arquivo</div>';
                chat.scrollTop = chat.scrollHeight;
            });
            
            // Limpar input
            fileInput.value = '';
        });
    }
    
    console.log('✅ Funções de imagem e upload restauradas!');
});
</script>


<script>
// Função para formatar texto com quebras de linha e markdown básico
function formatarTextoAnalise(texto) {
    if (!texto) return '';
    
    // Escapar HTML para segurança
    let formatado = texto
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
    
    // Converter quebras de linha duplas em parágrafos
    formatado = formatado.replace(/

+/g, '</p><p>');
    
    // Converter quebras de linha simples em <br>
    formatado = formatado.replace(/
/g, '<br>');
    
    // Envolver em parágrafo
    formatado = '<p>' + formatado + '</p>';
    
    // Formatar negrito (**texto**)
    formatado = formatado.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
    
    // Formatar itálico (*texto*)
    formatado = formatado.replace(/\*(.+?)\*/g, '<em>$1</em>');
    
    // Formatar listas (linhas começando com - ou *)
    formatado = formatado.replace(/(<br>|
)?[-*]\s+(.+?)(?=<br>|
|$)/g, '<li>$2</li>');
    formatado = formatado.replace(/(<li>.*<\/li>)/s, '<ul>$1</ul>');
    
    // Formatar números de lista (1. 2. 3.)
    formatado = formatado.replace(/(<br>|
)?\d+\.\s+(.+?)(?=<br>|
|$)/g, '<li>$2</li>');
    
    return formatado;
}

// Sobrescrever a função de upload para usar formatação
const originalFetch = window.fetch;
window.fetch = function(url, options) {
    return originalFetch.apply(this, arguments).then(response => {
        if (url === '/upload' && response.ok) {
            return response.json().then(data => {
                if (data.analysis) {
                    data.analysis_formatado = formatarTextoAnalise(data.analysis);
                }
                return new Response(JSON.stringify(data), {
                    status: response.status,
                    statusText: response.statusText,
                    headers: response.headers
                });
            });
        }
        return response;
    });
};
</script>




















<script>
// === UPLOAD - PROCESSAMENTO LINHA POR LINHA ===
document.addEventListener('DOMContentLoaded', function() {
    const fileInput = document.getElementById('file-input');
    if (!fileInput) return;
    
    fileInput.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (!file) return;
        
        const formData = new FormData();
        formData.append('file', file);
        
        const chat = document.getElementById('chat');
        if (!chat) return;
        
        // Loading
        const loadingId = 'upload-' + Date.now();
        const loadingDiv = document.createElement('div');
        loadingDiv.id = loadingId;
        loadingDiv.style.cssText = 'margin:10px 0;padding:15px;background:#1a1a1a;border-radius:8px;border-left:3px solid #00bcd4;text-align:center;';
        loadingDiv.innerHTML = '📎 Analisando: <strong>' + file.name + '</strong>';
        chat.appendChild(loadingDiv);
        chat.scrollTop = chat.scrollHeight;
        
        fetch('/upload', {
            method: 'POST',
            body: formData
        })
        .then(res => res.json())
        .then(data => {
            const loader = document.getElementById(loadingId);
            if (loader) loader.remove();
            
            const resultDiv = document.createElement('div');
            resultDiv.style.cssText = 'margin:10px 0;padding:15px;background:#1a1a1a;border-radius:8px;border-left:3px solid #00bcd4;line-height:1.8;';
            
            if (data.success || data.message) {
                let text = data.analysis || data.message || 'Arquivo processado';
                
                console.log('📝 Texto recebido (primeiros 100 chars):', text.substring(0, 100));
                
                // ESCAPAR HTML PRIMEIRO
                text = text.replace(/&/g, '&amp;')
                          .replace(/</g, '&lt;')
                          .replace(/>/g, '&gt;');
                
                // DIVIDIR EM LINHAS E PROCESSAR CADA UMA
                let linhas = text.split('\n');
                console.log('📊 Número de linhas:', linhas.length);
                
                let htmlFinal = '';
                
                for (let i = 0; i < linhas.length; i++) {
                    let linha = linhas[i].trim();
                    
                    if (linha === '') {
                        // Linha vazia = parágrafo
                        htmlFinal += '<br>';
                        continue;
                    }
                    
                    // Processar negrito **texto**
                    linha = linha.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
                    
                    // Processar itálico *texto*
                    linha = linha.replace(/\*([^*]+)\*/g, '<em>$1</em>');
                    
                    // Se começa com número (1., 2., etc.), adicionar bullet
                    if (/^\d+\./.test(linha)) {
                        htmlFinal += '<div style="margin-left:20px;margin-bottom:8px;">' + linha + '</div>';
                    }
                    // Se começa com * ou -, adicionar bullet
                    else if (/^[\*\-]/.test(linha)) {
                        linha = linha.replace(/^[\*\-]\s*/, '');
                        htmlFinal += '<div style="margin-left:20px;margin-bottom:8px;">• ' + linha + '</div>';
                    }
                    // Linha normal
                    else {
                        htmlFinal += '<div style="margin-bottom:8px;">' + linha + '</div>';
                    }
                }
                
                console.log('✅ HTML gerado');
                
                resultDiv.innerHTML = '<strong>📎 Arquivo analisado:</strong><br><br>' + htmlFinal;
            } else {
                resultDiv.innerHTML = '<strong style="color:#ff4444;">❌ Erro:</strong> ' + (data.error || 'Desconhecido');
            }
            
            chat.appendChild(resultDiv);
            chat.scrollTop = chat.scrollHeight;
        })
        .catch(err => {
            const loader = document.getElementById(loadingId);
            if (loader) loader.remove();
            
            const errDiv = document.createElement('div');
            errDiv.style.cssText = 'margin:10px 0;padding:10px;background:#1a1a1a;border-radius:8px;border-left:3px solid #ff4444;color:#ff4444;';
            errDiv.innerHTML = '❌ Erro: ' + err.message;
            chat.appendChild(errDiv);
        });
        
        fileInput.value = '';
    });
    
    console.log('✅ Upload com processamento linha por linha configurado!');
});
</script>


    
    <!-- Botão Voltar ao Desktop (Inferior Direito) -->
    <a href="/desktop" class="btn-voltar-desktop" style="position:fixed; bottom:30px; right:30px; background:linear-gradient(135deg, #6200ea, #00bcd4); color:white; padding:15px 25px; border-radius:30px; text-decoration:none; font-weight:bold; box-shadow:0 6px 20px rgba(98,0,234,0.5); z-index:999; transition:all 0.3s; display:flex; align-items:center; gap:10px; font-size:1.1em;" onmouseover="this.style.transform='translateY(-5px) scale(1.05)'; this.style.boxShadow='0 8px 25px rgba(98,0,234,0.7)'" onmouseout="this.style.transform='translateY(0) scale(1)'; this.style.boxShadow='0 6px 20px rgba(98,0,234,0.5)'">
        🖥️ <span>Desktop</span>
    </a>


<script>
// ============================================
// MARKDOWN + EXPORTAÇÃO (FASE 4)
// ============================================

// Renderizar Markdown
function renderizarMarkdown(texto) {
    if (!texto || typeof marked === 'undefined') return texto;
    try {
        marked.setOptions({ breaks: true, gfm: true });
        let html = marked.parse(texto);
        if (typeof DOMPurify !== 'undefined') {
            html = DOMPurify.sanitize(html);
        }
        return html;
    } catch (e) {
        console.error('Erro ao renderizar markdown:', e);
        return texto;
    }
}

// Exportar conversa
function exportarConversa() {
    const chat = document.getElementById('chat');
    if (!chat || chat.children.length === 0) {
        alert('❌ Nenhuma mensagem para exportar!');
        return;
    }
    
    let conteudo = '# 💬 Conversa ThinkinOS\n\n';
    conteudo += '📅 Exportado em: ' + new Date().toLocaleString('pt-BR') + '\n\n---\n\n';
    
    let count = 0;
    for (let i = 0; i < chat.children.length; i++) {
        const el = chat.children[i];
        const texto = el.textContent.trim();
        const style = el.getAttribute('style') || '';
        
        if (!texto) continue;
        if (style.includes('text-align:center') && style.includes('color:#888')) continue;
        
        let autor = '🤖 Assistente';
        if (style.includes('text-align:right') || style.includes('background:#2d2d2d')) {
            autor = '👤 Você';
        }
        
        conteudo += '### ' + autor + '\n\n' + texto + '\n\n---\n\n';
        count++;
    }
    
    if (count === 0) {
        alert('❌ Nenhuma mensagem encontrada!');
        return;
    }
    
    const blob = new Blob([conteudo], { type: 'text/markdown;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    const agora = new Date();
    a.download = 'thinkinos_' + agora.toISOString().slice(0,16).replace(/[:T]/g,'-') + '.md';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    
    // Feedback visual
    const feedback = document.createElement('div');
    feedback.style.cssText = 'margin:10px 0;padding:10px;background:#1a1a1a;border-radius:8px;border-left:3px solid #4caf50;color:#4caf50;text-align:center;';
    feedback.textContent = '✅ Exportado! ' + count + ' mensagens';
    chat.appendChild(feedback);
    chat.scrollTop = chat.scrollHeight;
    setTimeout(() => feedback.remove(), 3000);
    
    console.log('✅ Exportação concluída: ' + count + ' mensagens');
}

// Observer para aplicar Markdown automaticamente nas respostas da IA
const markdownObserver = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
        mutation.addedNodes.forEach((node) => {
            if (node.nodeType === 1) {
                // Procurar elementos que contenham respostas da IA
                const elements = node.querySelectorAll ? node.querySelectorAll('div[style*="border-left"]') : [];
                elements.forEach(el => {
                    const textoOriginal = el.textContent;
                    if (textoOriginal && (textoOriginal.includes('**') || textoOriginal.includes('```') || textoOriginal.includes('# ') || textoOriginal.includes('- '))) {
                        // Não re-renderizar se já foi processado
                        if (!el.dataset.markdownProcessed) {
                            el.innerHTML = renderizarMarkdown(textoOriginal);
                            el.dataset.markdownProcessed = 'true';
                        }
                    }
                });
            }
        });
    });
});

document.addEventListener('DOMContentLoaded', () => {
    const chat = document.getElementById('chat');
    if (chat) {
        markdownObserver.observe(chat, { childList: true, subtree: true });
    }
    console.log('✅ Markdown + Exportação (Fase 4) carregados!');
});
</script>

</body>
</html>
