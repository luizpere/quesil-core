<script>
// HOT RELOAD INTELIGENTE: Complemento ao Live Preview existente
(function() {
    'use strict';
    
    // Aguardar SocketIO do Live Preview já estar conectado
    setTimeout(() => {
        if (typeof io !== 'undefined') {
            console.log(" [HOT RELOAD] Adicionando handlers inteligentes...");
            
            const hotSocket = io();
            
            hotSocket.on('file_saved', (data) => {
                const filename = data.file;
                const filetype = data.type || (filename.endsWith('.css') ? 'css' : filename.endsWith('.js') ? 'js' : 'html');
                
                // CSS: Atualização dinâmica sem reload
                if (filetype === 'css') {
                    console.log(`🎨 [HOT RELOAD] CSS detectado: ${filename}`);
                    handleCSSUpdate(filename);
                }
                // JS: Execução dinâmica
                else if (filetype === 'js') {
                    console.log(` [HOT RELOAD] JS detectado: ${filename}`);
                    handleJSUpdate(filename);
                }
                // HTML: Deixar o Live Preview existente cuidar do reload
                else if (filetype === 'html') {
                    console.log(` [HOT RELOAD] HTML - Live Preview existente cuidará do reload`);
                }
            });
        }
    }, 1000); // Aguardar 1s para garantir que Live Preview já conectou
    
    function handleCSSUpdate(filename) {
        fetch(`/${filename}?t=${Date.now()}`)
            .then(response => response.text())
            .then(cssText => {
                let styleTag = document.getElementById(`hot-reload-${filename}`);
                if (!styleTag) {
                    styleTag = document.createElement('style');
                    styleTag.id = `hot-reload-${filename}`;
                    document.head.appendChild(styleTag);
                }
                styleTag.textContent = cssText;
                console.log(`✅ [CSS] ${filename} atualizado (${cssText.length} bytes)`);
            })
            .catch(err => console.error(`❌ [CSS] Erro: ${err}`));
    }
    
    function handleJSUpdate(filename) {
        fetch(`/${filename}?t=${Date.now()}`)
            .then(response => response.text())
            .then(jsText => {
                const oldScript = document.getElementById(`hot-reload-${filename}`);
                if (oldScript) oldScript.remove();
                
                const newScript = document.createElement('script');
                newScript.id = `hot-reload-${filename}`;
                newScript.textContent = jsText;
                document.body.appendChild(newScript);
                console.log(`✅ [JS] ${filename} executado`);
            })
            .catch(err => console.error(` [JS] Erro: ${err}`));
    }
})();
</script>

