                <span>Privacidade</span>
            </div>
            <div class="setting-control">
                <span style="color: var(--text-muted); font-size: 12px;">Em breve</span>
            </div>
        </div>
    </div>
</div>


<script>
// === SISTEMA DE CONFIGURAÇÕES ===
console.log("⚙️ [CONFIG] Sistema carregado");

// Abrir configurações
window.openSettings = function() {
    console.log("⚙️ [CONFIG] Abrindo modal...");
    const modal = document.getElementById('settings-modal');
    const overlay = document.getElementById('settings-overlay');
    
    if (modal) {
        modal.classList.add('active');
        modal.style.display = 'block';
    }
    if (overlay) {
        overlay.classList.add('active');
        overlay.style.display = 'block';
    }
    
    // Atualizar botões de tema
    updateThemeButtons();
};

// Fechar configurações
window.closeSettings = function() {
    console.log("🔒 [CONFIG] Fechando modal...");
    const modal = document.getElementById('settings-modal');
    const overlay = document.getElementById('settings-overlay');
    
    if (modal) {
        modal.classList.remove('active');
        modal.style.display = 'none';
    }
    if (overlay) {
        overlay.classList.remove('active');
        overlay.style.display = 'none';
    }
};

// Definir tema
window.setTheme = function(theme) {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('thinkinos-theme', theme);
    updateThemeButtons();
    
    console.log("✅ [CONFIG] Tema definido:", theme);
    
    if (typeof window.showToast === 'function') {
        window.showToast('Tema ' + (theme === 'dark' ? 'escuro' : 'claro') + ' ativado', 'success', 2000);
    }
};

// Atualizar botões de tema
function updateThemeButtons() {
    const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
    const darkBtn = document.getElementById('theme-dark-btn');
    const lightBtn = document.getElementById('theme-light-btn');
    
    if (darkBtn && lightBtn) {
        darkBtn.classList.toggle('active', currentTheme === 'dark');
        lightBtn.classList.toggle('active', currentTheme === 'light');
    }
}

// Mudar idioma (preparado para futuro)
window.changeLanguage = function(lang) {
    console.log("🌐 [CONFIG] Idioma selecionado:", lang);
    localStorage.setItem('thinkinos-lang', lang);
    
    if (typeof window.showToast === 'function') {
        const langNames = {pt: 'Português', en: 'English', es: 'Español'};
        window.showToast('Idioma: ' + langNames[lang], 'info', 2000);
    }
};

// Inicializar
document.addEventListener('DOMContentLoaded', function() {
    const savedTheme = localStorage.getItem('thinkinos-theme') || 'dark';
    document.documentElement.setAttribute('data-theme', savedTheme);
    updateThemeButtons();
    
    const savedLang = localStorage.getItem('thinkinos-lang') || 'pt';
    const langSelect = document.getElementById('lang-select');
    if (langSelect) langSelect.value = savedLang;
    
    console.log("✅ [CONFIG] Inicializado");
});

// ESC para fechar
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') window.closeSettings();
});
</script>

</body>
</html>


