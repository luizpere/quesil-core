    }
}

// === TERMINAL WEB ===
let terminal = null;
let socket = null;
let currentContainerId = null;

// === TERMINAL WEB MELHORADO V4.1 ===
let commandHistory = [];
let historyIndex = -1;
let currentLine = '';
let autocompleteSuggestions = [];

function openTerminal(containerId, containerName) {
    console.log("Abrindo terminal melhorado para:", containerId, containerName);
    currentContainerId = containerId;
    document.getElementById('terminal-container-name').textContent = containerName;
    document.getElementById('terminal-modal').classList.add('active');
    document.getElementById('terminal-overlay').classList.add('active');
    
    // Aguardar o modal ficar visível antes de inicializar
    setTimeout(() => {
    if (!terminal) {
        terminal = new Terminal({
            cursorBlink: true,
            fontSize: 14,
            fontFamily: '"Courier New", Courier, monospace',
            theme: {
                background: '#000000',
                foreground: '#00ff00',
                cursor: '#00ff00',
                cursorAccent: '#000000',
                selection: 'rgba(0, 255, 0, 0.3)',
                black: '#000000',
                red: '#ff5555',
                green: '#50fa7b',
                yellow: '#f1fa8c',
                blue: '#bd93f9',
                magenta: '#ff79c6',
                cyan: '#8be9fd',
                white: '#bbbbbb',
                brightBlack: '#555555',
                brightRed: '#ff6e67',
                brightGreen: '#69ff94',
                brightYellow: '#ffffa5',
                brightBlue: '#d6acff',
                brightMagenta: '#ff92df',
                brightCyan: '#a4ffff',
                brightWhite: '#ffffff'
            },
            scrollback: 10000,
            tabStopWidth: 4
        });
        
        window.fitAddon = new FitAddon.FitAddon();
        terminal.loadAddon(fitAddon);
        terminal.open(document.getElementById('terminal-container'));
        
        // Ajustar tamanho inicial e em resize
        setTimeout(() => {
            fitAddon.fit();
            console.log("Terminal ajustado");
        }, 100);
        
        window.addEventListener('resize', () => {
            fitAddon.fit();
        });
        
        // Capturar teclas com histórico e autocomplete
        terminal.onKey(e => {
            const ev = e.domEvent;
            const key = ev.key;
            
            if (key === 'Enter') {
                // Enviar comando
                terminal.write('\r\n');
                if (currentLine.trim()) {
                    // Adicionar ao histórico
                    if (commandHistory.length === 0 || commandHistory[commandHistory.length - 1] !== currentLine) {
                        commandHistory.push(currentLine);
                    }
                    if (commandHistory.length > 100) commandHistory.shift();
                    historyIndex = -1;
                    
                    // Enviar para servidor
                    console.log("Enviando comando:", currentLine);
                    if (socket && socket.connected) {
                        socket.emit('terminal_input', { 
                            container_id: currentContainerId, 
                            command: currentLine 
                        });
                    }
                }
                currentLine = '';
            } else if (key === 'ArrowUp') {
                // Histórico anterior
                if (historyIndex < commandHistory.length - 1) {
                    historyIndex++;
                    currentLine = commandHistory[commandHistory.length - 1 - historyIndex];
                    // Limpar linha atual e escrever nova
                    terminal.write('\r\x1b[K');
                    terminal.write('# ' + currentLine);
                }
            } else if (key === 'ArrowDown') {
                // Histórico próximo
                if (historyIndex > -1) {
                    historyIndex--;
                    currentLine = historyIndex === -1 ? '' : commandHistory[commandHistory.length - 1 - historyIndex];
                    terminal.write('\r\x1b[K');
                    terminal.write('# ' + currentLine);
                }
            } else if (key === 'Tab') {
                // Autocomplete (simplificado)
                ev.preventDefault();
                if (currentLine.trim()) {
                    // Comandos comuns para autocomplete
                    const commonCommands = ['ls', 'cd', 'pwd', 'cat', 'echo', 'mkdir', 'rm', 'cp', 'mv', 'grep', 'find', 'chmod', 'chown', 'ps', 'top', 'free', 'df', 'du', 'whoami', 'uname', 'apk', 'apt', 'yum'];
                    const matches = commonCommands.filter(cmd => cmd.startsWith(currentLine.trim()));
                    if (matches.length === 1) {
                        currentLine = matches[0] + ' ';
                        terminal.write('\x1b[K ' + matches[0].substring(currentLine.length) + ' ');
                    } else if (matches.length > 1) {
                        terminal.write('\r\n');
                        matches.forEach(m => terminal.write(m + '  '));
                        terminal.write('\r\n# ' + currentLine);
                    }
                }
            } else if (key === 'Backspace') {
                if (currentLine.length > 0) {
                    currentLine = currentLine.slice(0, -1);
                    terminal.write('\b \b');
                }
            } else if (key === 'c' && ev.ctrlKey) {
                // Ctrl+C - cancelar
                terminal.write('^C\r\n# ');
                currentLine = '';
            } else if (key === 'l' && ev.ctrlKey) {
                // Ctrl+L - limpar tela
                terminal.clear();
                terminal.write('# ');
            } else if (key.length === 1 && !ev.ctrlKey && !ev.altKey) {
                currentLine += key;
                terminal.write(key);
            }
        });
    }
    
    // Conectar Socket.IO
    socket = io();
    
    socket.on('connect', () => {
        console.log("Socket.IO conectado");
        terminal.write('\r\n\x1b[32m╔════════════════════════════════════════╗\r\n');
        terminal.write('\x1b[32m║  Conectado ao container ' + containerId.padEnd(20, ' ') + '  ║\r\n');
        terminal.write('\x1b[32m╚════════════════════════════════════════╝\r\n\x1b[0m');
        terminal.write('\x1b[33mDigite \x1b[36mhelp\x1b[33m para ver comandos disponíveis\r\n\r\n');
        terminal.write('# ');
    });
    
    socket.on('terminal_output', (data) => {
        console.log("Recebido:", data.output);
        terminal.write(data.output);
        if (!data.output.endsWith('\n')) {
            terminal.write('\r\n# ');
        } else {
            terminal.write('# ');
        }
    });
    
    socket.on('disconnect', () => {
        terminal.write('\r\n\x1b[31m\n[Conexão perdida com o container]\x1b[0m\r\n');
    });
    
    // Chamar refit após tudo estar pronto
    refitTerminal();
    }, 100); // fim do setTimeout
}

function closeTerminal() {
    console.log("Fechando terminal");
    if (socket) {
        socket.disconnect();
        socket = null;
    }
    if (terminal) {
        terminal.dispose();
        terminal = null;
    }
    document.getElementById('terminal-modal').classList.remove('active');
    document.getElementById('terminal-overlay').classList.remove('active');
}

