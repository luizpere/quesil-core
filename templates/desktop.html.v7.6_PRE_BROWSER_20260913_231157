async function stopVM(id) {
    if (!confirm('Parar esta VM?')) return;
    try {
        const resp = await fetch('/api/vm/stop/' + id, { method: 'POST' });
        const data = await resp.json();
        if (data.success) {
            loadVMs();
        } else {
            alert("Erro ao parar: " + (data.error || "Desconhecido"));
            loadVMs();
        }
    } catch (e) {
        alert("Erro de conexão: " + e.message);
    }
}

async function startVMById(id) {
    console.log("Iniciando container:", id);
    const listDiv = document.getElementById('vm-list');
    listDiv.innerHTML = '<p style="text-align: center; color: #0db7ed;">⏳ Iniciando container...</p>';
    
    try {
