    if (files.length === 0) {
        list.innerHTML = '<div style="color:#888;text-align:center;padding:40px;grid-column:1/-1;">Nenhum arquivo encontrado</div>';
        return;
    }
    
    files.forEach(function(file) {
        var filename = typeof file === 'string' ? file : (file.name || file.filename);
        var isDir = file.is_dir || false;
        var ext = (filename.split('.').pop() || '').toLowerCase();
        var icons = {'pdf':'📕','jpg':'🖼️','jpeg':'️','png':'🖼️','gif':'🖼️','svg':'🖼️','txt':'📄','md':'','py':'🐍','js':'📜','json':'📋','folder':'📁','odt':'','doc':'📄','docx':'','xls':'📊','xlsx':'','csv':'📊'};
        var icon = isDir ? '📁' : (icons[ext] || '📄');
        
        var card = document.createElement('div');
        card.className = 'fm-file-item';
        card.setAttribute('data-tooltip', filename);
        card.innerHTML = '<div style="font-size:48px;color:#4dabf7;animation:pulse 2s infinite;">' + icon + '</div>' +
                       '<div style="color:#fff;font-size:12px;word-break:break-word;max-height:40px;overflow:hidden;">' + filename + '</div>' +
                       '<div><button style="background:#51cf66;color:#fff;border:none;padding:8px;border-radius:4px;cursor:pointer;" data-tooltip="Download">⬇️</button> ' +
                       '<button style="background:#ff6b6b;color:#fff;border:none;padding:8px;border-radius:4px;cursor:pointer;" data-tooltip="Deletar">🗑️</button></div>';
        
        card.onclick = function(e) {
