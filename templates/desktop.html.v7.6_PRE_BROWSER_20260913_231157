        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            background: #0a0a0a; 
            color: #fff; 
            font-family: 'Segoe UI', sans-serif; 
            min-height: 100vh;
            padding-bottom: 100px;
        }
        .header { 
            padding: 20px; 
            border-bottom: 1px solid #333;
            position: relative;
        }
        .logout-btn { 
            position: absolute; 
            top: 20px; 
            right: 20px; 
            background: #f44336; 
            color: white; 
            padding: 10px 20px; 
            border: none; 
            border-radius: 4px; 
            cursor: pointer; 
        }
        .grid { 
            display: grid; 
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); 
            gap: 12px; 
            padding: 20px; 
        }
        .card { 
            background: #1a1a1a; 
            border-radius: 8px; 
            padding: 20px; 
            border-left: 4px solid #4caf50; 
            cursor: pointer; 
            transition: transform 0.2s; 
        }
        .card:hover { transform: translateY(-5px); }
        .card-header { 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            margin-bottom: 10px; 
        }
        .card-title { font-size: 1.5em; font-weight: bold; }
        .card-category { color: #4caf50; font-size: 0.9em; margin-bottom: 10px; }
        .card-desc { color: #888; font-size: 0.95em; line-height: 1.5; }
        
        /* DOCK HORIZONTAL */
        .dock {
            position: fixed !important;
            bottom: 20px !important;
            left: 50% !important;
            transform: translateX(-50%) !important;
            background: rgba(30, 30, 30, 0.95) !important;
            border-radius: 16px !important;
            padding: 10px 20px !important;
            display: flex !important;
            flex-direction: row !important;
            gap: 10px !important;
            z-index: 100 !important;
            border: 1px solid #444 !important;
        }
        .dock-item {
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            cursor: pointer !important;
            padding: 8px 12px !important;
            border-radius: 8px !important;
            color: #fff !important;
            text-decoration: none !important;
        }
        .dock-item:hover { background: rgba(255,255,255,0.15) !important; }
        .dock-icon { font-size: 1.8em !important; }
        .dock-label { font-size: 0.75em !important; margin-top: 4px !important; }
        
        /* MODAL VM */
        .vm-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0,0,0,0.7);
            z-index: 1000;
        }
        .vm-overlay.active { display: block; }
        .vm-modal {
            display: none;
            position: fixed;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            background: #1a1a1a;
            border-radius: 12px;
            padding: 20px;
            max-width: 900px; max-height: 80vh; overflow-y: auto;
            width: 90%;
            z-index: 1001;
            border: 1px solid #444;
        }
        .vm-modal.active { display: block; }
        .vm-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 1px solid #333;
        }
        .close-btn { background: none; border: none; color: #fff; font-size: 2em; cursor: pointer; }
        .vm-actions { display: flex; gap: 10px; margin-bottom: 15px; flex-wrap: wrap; }
        .vm-list { background: rgba(0,0,0,0.3); padding: 15px; border-radius: 8px; min-height: 100px; }
        .vm-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px;
            border-bottom: 1px solid #333;
        }
        .status-running { color: #4caf50; }
        .status-exited { color: #f44336; }
        .btn { padding: 8px 16px; border: none; border-radius: 4px; cursor: pointer; margin: 5px; }
        .btn-primary { background: #2196F3; color: white; }
        .btn-danger { background: #f44336; color: white; }
    
/* Glassmorphism Effects */
