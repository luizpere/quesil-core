<script>
// === FILE MANAGER v7.0 - MINIMALISTA ===
console.log("📦 [FM v7.0] Iniciando...");

// Funções globais explícitas
window.openFM = function() {
    console.log(" [FM] Abrindo...");
    var modal = document.getElementById('fm-modal');
    var overlay = document.getElementById('fm-overlay');
    if (modal) {
        modal.style.display = 'flex';
        modal.classList.add('active');
    }
    if (overlay) {
        overlay.style.display = 'block';
        overlay.classList.add('active');
    }
    window.loadFM();
};

window.closeFM = function() {
    console.log("🔒 [FM] Fechando...");
    var modal = document.getElementById('fm-modal');
    var overlay = document.getElementById('fm-overlay');
    if (modal) {
        modal.style.display = 'none';
        modal.classList.remove('active');
    }
    if (overlay) {
        overlay.style.display = 'none';
        overlay.classList.remove('active');
    }
    window.closeViewerFM();
};

window.loadFM = function() {
    console.log("📁 [FM] Carregando arquivos...");
    var list = document.getElementById('fm-file-list');
    if (!list) return;
    
    fetch('/api/files/list')
    .then(function(r) { return r.json(); })
    .then(function(data) {
        list.innerHTML = '';
        var files = data.files || data || [];
        console.log("📄 [FM] Total:", files.length);
        
        if (files.length === 0) {
            list.innerHTML = '<div style="color:#888;text-align:center;padding:40px;grid-column:1/-1;">Nenhum arquivo</div>';
            return;
        }
        
        files.forEach(function(file) {
            var filename = typeof file === 'string' ? file : (file.name || file.filename);
            var isDir = file.is_dir || false;
            var ext = (filename.split('.').pop() || '').toLowerCase();
            var icons = {'pdf':'📕','jpg':'🖼️','png':'🖼️','txt':'📄','folder':'📁'};
            var icon = isDir ? '' : (icons[ext] || '');
            
            var card = document.createElement('div');
            card.className = 'fm-file-item';
            card.innerHTML = '<div style="font-size:48px;color:#4dabf7;">' + icon + '</div>' +
                           '<div style="color:#fff;font-size:12px;">' + filename + '</div>' +
                           '<div><button style="background:#51cf66;color:#fff;border:none;padding:8px;border-radius:4px;cursor:pointer;">⬇️</button> ' +
                           '<button style="background:#ff6b6b;color:#fff;border:none;padding:8px;border-radius:4px;cursor:pointer;">️</button></div>';
            
            card.onclick = function(e) {
                if (e.target.tagName !== 'BUTTON') {
                    window.openViewerFM(filename, isDir);
                }
            };
            
            var btns = card.querySelectorAll('button');
            btns[0].onclick = function(e) {
                e.stopPropagation();
                window.open('/api/files/download/' + encodeURIComponent(filename), '_blank');
            };
            btns[1].onclick = function(e) {
                e.stopPropagation();
                if (confirm('Deletar?')) {
                    fetch('/api/files/delete/' + encodeURIComponent(filename), {method:'DELETE'})
                    .then(function() { window.loadFM(); });
                }
            };
            
            list.appendChild(card);
        });
        console.log("✅ [FM] Renderizado");
        
        // Salvar arquivos globais para busca/ordenação
        window._fm_all_files = files;
        window._fm_current_files = files;
        
        // Aplicar filtros/ordenação atuais
        window.filterFM();
    });
};

// Busca
window.filterFM = function() {
    var search = document.getElementById('fm-search');
    if (!search) return;
    
    var query = search.value.toLowerCase();
    var list = document.getElementById('fm-file-list');
    if (!list || !window._fm_all_files) return;
    
    var filtered = window._fm_all_files.filter(function(file) {
        var filename = typeof file === 'string' ? file : (file.name || file.filename);
        return filename.toLowerCase().includes(query);
    });
    
    window._fm_current_files = filtered;
    window.renderFMFiles(filtered);
    console.log(" [FM] Busca:", query, "->", filtered.length, "resultados");
};

// Ordenação
window.sortFM = function() {
    var sort = document.getElementById('fm-sort');
    if (!sort || !window._fm_current_files) return;
    
    var criteria = sort.value;
    var sorted = window._fm_current_files.slice();
    
    sorted.sort(function(a, b) {
        var nameA = (typeof a === 'string' ? a : (a.name || a.filename)).toLowerCase();
        var nameB = (typeof b === 'string' ? b : (b.name || b.filename)).toLowerCase();
        var extA = nameA.split('.').pop().toLowerCase();
        var extB = nameB.split('.').pop().toLowerCase();
        
        if (criteria === 'name') return nameA.localeCompare(nameB);
        if (criteria === 'name-desc') return nameB.localeCompare(nameA);
        if (criteria === 'type') {
            var isDirA = a.is_dir || false;
            var isDirB = b.is_dir || false;
            if (isDirA !== isDirB) return isDirA ? -1 : 1;
            return nameA.localeCompare(nameB);
        }
        if (criteria === 'ext') return extA.localeCompare(extB);
        return 0;
    });
    
    window.renderFMFiles(sorted);
    console.log("📊 [FM] Ordenado por:", criteria);
};

// Renderizar arquivos (função auxiliar)
window.renderFMFiles = function(files) {
