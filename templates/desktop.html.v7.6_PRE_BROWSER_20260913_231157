    <!-- xterm.js para Terminal Web -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/xterm@5.3.0/css/xterm.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/xterm@5.3.0/lib/xterm.min.js">
// === TERMINAL WEB ===
let terminal = null;
let socket = null;
let currentContainerId = null;

function openTerminal(containerId, containerName) {
    console.log("Abrindo terminal para:", containerId, containerName);
    currentContainerId = containerId;
    document.getElementById('terminal-container-name').textContent = containerName;
    document.getElementById('terminal-modal').classList.add('active');
    document.getElementById('terminal-overlay').classList.add('active');
    
    // Inicializar xterm.js
    if (!terminal) {
        terminal = new Terminal({
            cursorBlink: true,
            fontSize: 14,
            fontFamily: '"Courier New", Courier, monospace',
            theme: { background: '#000', foreground: '#0f0', cursor: '#0f0' }
        });
        window.fitAddon = new FitAddon.FitAddon();
        terminal.loadAddon(fitAddon);
        terminal.open(document.getElementById('terminal-container'));
        fitAddon.fit();
        
        let currentLine = '';
        
        // Capturar input do teclado - acumular até Enter
        terminal.onKey(e => {
            const ev = e.domEvent;
            
            if (ev.key === 'Enter') {
                // Enviar comando completo
                console.log("Enviando comando:", currentLine);
                terminal.write('\r\n');
                if (socket && socket.connected && currentLine.trim()) {
                    socket.emit('terminal_input', { 
                        container_id: currentContainerId, 
                        command: currentLine 
                    });
                }
                currentLine = '';
            } else if (ev.key === 'Backspace') {
                if (currentLine.length > 0) {
                    currentLine = currentLine.slice(0, -1);
                    terminal.write('\b \b');
                }
            } else if (e.key.length === 1) {
                currentLine += e.key;
                terminal.write(e.key);
            }
        });
    }
    
    // Conectar Socket.IO
    socket = io();
    
    socket.on('connect', () => {
        console.log("Socket.IO conectado");
        terminal.write('\r\n\x1b[32mConectado ao container ' + containerId + '\x1b[0m\r\n');
        terminal.write('# ');
    });
    
    socket.on('terminal_output', (data) => {
        console.log("Recebido do servidor:", data.output);
        terminal.write(data.output);
        if (!data.output.endsWith('\n')) {
            terminal.write('\r\n# ');
        } else {
            terminal.write('# ');
        }
    });
    
    socket.on('disconnect', () => {
        terminal.write('\r\n\x1b[31mConexão perdida.\x1b[0m\r\n');
    });
}

function closeTerminal() {
    console.log("Fechando terminal");
    if (socket) {
        socket.disconnect();
        socket = null;
    }
    if (terminal) {
        terminal.dispose();
        terminal = null;
    }
    document.getElementById('terminal-modal').classList.remove('active');
    document.getElementById('terminal-overlay').classList.remove('active');
}


function showComingSoon(feature) {
    alert(feature + ' - Em desenvolvimento!\n\nEsta funcionalidade estará disponível em breve.');
}


// Função para re-ajustar o terminal quando o modal abre
function refitTerminal() {
    if (terminal && typeof fitAddon !== 'undefined' && fitAddon) {
        setTimeout(() => {
            try {
                fitAddon.fit();
                console.log("Terminal redimensionado:", terminal.cols, "x", terminal.rows);
            } catch (e) {
                console.error("Erro ao redimensionar:", e);
            }
        }, 300);
    }
}

</script>
