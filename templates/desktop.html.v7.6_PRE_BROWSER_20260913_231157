<body>
    <div class="header">
        <h1>ThinkinOS <span style="color: #4caf50;">v2.0</span></h1>
        <div style="position: absolute; top: 20px; right: 120px; color: #fff; font-size: 1.1em; font-family: 'Courier New', monospace;" id="clock">00:00:00</div>
        
        <button class="logout-btn" onclick="location.href='/logout'">Sair</button>
