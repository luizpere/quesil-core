<script>
// === MODAL DE MÉTRICAS ===
console.log("📊 [MÉTRICAS MODAL] Carregado");

window._cpuHistory = [];
window._metricsInterval = null;

window.openMetrics = function() {
    console.log(" [MÉTRICAS] ========== ABRINDO MODAL ==========");
    const modal = document.getElementById('metrics-modal');
    const overlay = document.getElementById('metrics-overlay');
    
    if (modal) {
        modal.classList.add('active');
        modal.style.display = 'flex';
        console.log("✅ [MÉTRICAS] Modal exibido");
    } else {
        console.error("❌ [MÉTRICAS] Modal não encontrado!");
    }
    if (overlay) {
        overlay.classList.add('active');
        overlay.style.display = 'block';
    }
    
    // Aguardar e atualizar
    setTimeout(() => {
        console.log("🔄 [MÉTRICAS] Iniciando atualização...");
        window.updateMetrics();
        if (!window._metricsInterval) {
            window._metricsInterval = setInterval(window.updateMetrics, 2000);
            console.log("✅ [MÉTRICAS] Intervalo de 2s iniciado");
        }
    }, 100);
};

window.closeMetrics = function() {
    console.log("🔒 [MÉTRICAS] Fechando modal...");
    const modal = document.getElementById('metrics-modal');
    const overlay = document.getElementById('metrics-overlay');
    
    if (modal) {
        modal.classList.remove('active');
        modal.style.display = 'none';
    }
    if (overlay) {
        overlay.classList.remove('active');
        overlay.style.display = 'none';
    }
    
    if (window._metricsInterval) {
        clearInterval(window._metricsInterval);
        window._metricsInterval = null;
    }
};

window.updateMetrics = function() {
    fetch('/api/metrics')
    .then(r => r.json())
    .then(data => {
        if (data.error) {
            console.error("❌ [MÉTRICAS] Erro:", data.error);
            return;
        }
        
        console.log("📊 [MÉTRICAS] Dados:", data);
        
        // CPU
        const cpuPercent = data.cpu || 0;
        const cpuValue = document.getElementById('cpu-value');
        const cpuBar = document.getElementById('cpu-bar');
        if (cpuValue) cpuValue.textContent = cpuPercent.toFixed(1) + '%';
        if (cpuBar) {
            cpuBar.style.width = cpuPercent + '%';
            let cpuClass = 'low';
            if (cpuPercent >= 80) cpuClass = 'high';
            else if (cpuPercent >= 50) cpuClass = 'medium';
            cpuBar.className = 'metric-bar-fill ' + cpuClass;
            console.log("🖥️ [CPU]", cpuPercent + "% -", cpuClass);
        }
        
        // Gráfico CPU
        window._cpuHistory.push(cpuPercent);
        if (window._cpuHistory.length > 20) window._cpuHistory.shift();
        const svgPath = document.getElementById('cpu-chart-path');
        if (svgPath && window._cpuHistory.length > 1) {
            const points = window._cpuHistory.map((val, i) => {
                const x = (i / (window._cpuHistory.length - 1)) * 100;
                const y = 60 - (val / 100) * 60;
                return `${x},${y}`;
            });
            svgPath.setAttribute('d', 'M' + points.join(' L'));
        }
        
        // RAM
        const ramPercent = data.ram_percent || 0;
        const ramValue = document.getElementById('ram-value');
        const ramBar = document.getElementById('ram-bar');
        if (ramValue) ramValue.textContent = ramPercent.toFixed(1) + '%';
        if (ramBar) {
            ramBar.style.width = ramPercent + '%';
            let ramClass = 'low';
            if (ramPercent >= 80) ramClass = 'high';
            else if (ramPercent >= 50) ramClass = 'medium';
            ramBar.className = 'metric-bar-fill ' + ramClass;
            console.log("💾 [RAM]", ramPercent + "% -", ramClass);
        }
        const ramDetails = document.getElementById('ram-details');
        if (ramDetails) ramDetails.textContent = `${data.ram_used_gb || 0} GB / ${data.ram_total_gb || 0} GB`;
        
        // Disco
        const diskPercent = data.disk_percent || 0;
        const diskValue = document.getElementById('disk-value');
        const diskBar = document.getElementById('disk-bar');
        if (diskValue) diskValue.textContent = diskPercent.toFixed(1) + '%';
        if (diskBar) {
            diskBar.style.width = diskPercent + '%';
            let diskClass = 'low';
            if (diskPercent >= 80) diskClass = 'high';
            else if (diskPercent >= 50) diskClass = 'medium';
            diskBar.className = 'metric-bar-fill ' + diskClass;
            console.log("💽 [DISCO]", diskPercent + "% -", diskClass);
        }
        const diskDetails = document.getElementById('disk-details');
        if (diskDetails) diskDetails.textContent = `${data.disk_used_gb || 0} GB / ${data.disk_total_gb || 0} GB`;
    })
    .catch(err => {
        console.error("❌ [MÉTRICAS] Erro:", err);
    });
};

// ESC para fechar
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') window.closeMetrics();
});

// Vincular card de Métricas ao modal
document.addEventListener('DOMContentLoaded', function() {
    setTimeout(() => {
        const cards = document.querySelectorAll('.card, [class*="card"]');
        cards.forEach(card => {
            const text = card.textContent || '';
            if (text.includes('Métricas') && text.includes('Monitorar')) {
                card.style.cursor = 'pointer';
                card.onclick = function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    console.log("📊 [MÉTRICAS] Card clicado!");
                    window.openMetrics();
                };
                console.log("✅ [MÉTRICAS] Card vinculado");
            }
        });
    }, 1000);
});
</script>


<script>
// === SISTEMA DE TEMA CLARO/ESCURO ===
console.log("🎨 [TEMA] Sistema carregado");

// Detectar tema do sistema ou localStorage
function getPreferredTheme() {
    const saved = localStorage.getItem('thinkinos-theme');
    if (saved) {
        console.log("💾 [TEMA] Tema salvo:", saved);
        return saved;
    }
    
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const theme = prefersDark ? 'dark' : 'light';
    console.log("🔍 [TEMA] Tema do sistema:", theme);
    return theme;
}

// Aplicar tema
function applyTheme(theme) {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('thinkinos-theme', theme);
    
    const toggle = document.getElementById('theme-toggle');
    if (toggle) {
        toggle.textContent = theme === 'dark' ? '️' : '🌙';
        toggle.title = theme === 'dark' ? 'Tema claro' : 'Tema escuro';
    }
    
    console.log("✅ [TEMA] Tema aplicado:", theme);
}

// Toggle tema
window.toggleTheme = function() {
    const current = document.documentElement.getAttribute('data-theme');
    const newTheme = current === 'dark' ? 'light' : 'dark';
    applyTheme(newTheme);
    
    // Toast de notificação
    if (typeof window.showToast === 'function') {
        window.showToast('Tema ' + (newTheme === 'dark' ? 'escuro' : 'claro') + ' ativado', 'info', 2000);
    }
};

// Inicializar tema
document.addEventListener('DOMContentLoaded', function() {
    const theme = getPreferredTheme();
    applyTheme(theme);
    
    // Observar mudanças no tema do sistema
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        const newTheme = e.matches ? 'dark' : 'light';
        applyTheme(newTheme);
        console.log("🔄 [TEMA] Sistema mudou para:", newTheme);
    });
    
    console.log("✅ [TEMA] Sistema inicializado");
});
</script>


