window.openViewerFM = function(filename, isDir) {
    console.log("👁️ [FM] Abrindo viewer:", filename);
    if (isDir) { alert('Pastas não podem ser visualizadas'); return; }
    
    document.querySelector('.fm-toolbar').style.display = 'none';
    document.getElementById('fm-upload-area').style.display = 'none';
    document.getElementById('fm-file-list').style.display = 'none';
    
    var viewer = document.getElementById('fm-viewer');
    var content = document.getElementById('fm-viewer-content');
    
    if (viewer && content) {
        viewer.style.display = 'flex';
        viewer.classList.add('active');
        document.getElementById('fm-viewer-title').textContent = filename;
        
        var ext = filename.split('.').pop().toLowerCase();
        var url = '/api/files/view/' + encodeURIComponent(filename);
        
        if (ext === 'pdf') {
            content.innerHTML = '<iframe src="' + url + '" type="application/pdf" style="width:100%;height:100%;border:none;"></iframe>';
        } else if (['jpg','jpeg','png','gif','svg','webp','bmp'].includes(ext)) {
            content.innerHTML = '<img src="' + url + '" style="max-width:100%;max-height:100%;display:block;margin:auto;">';
        } else if (['txt','md','py','js','json','html','css','xml','csv','log','sh','bat'].includes(ext)) {
            fetch(url).then(function(r) { return r.text(); })
            .then(function(text) {
                content.innerHTML = '<pre style="color:#e0e0e0;padding:20px;overflow:auto;white-space:pre-wrap;font-family:monospace;font-size:13px;">' + text.replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</pre>';
            });
        } else if (['mp4','webm','ogg'].includes(ext)) {
            content.innerHTML = '<video src="' + url + '" controls style="max-width:100%;max-height:100%;display:block;margin:auto;"></video>';
        } else if (['mp3','wav','ogg'].includes(ext)) {
            content.innerHTML = '<audio src="' + url + '" controls style="width:100%;margin-top:50px;"></audio><div style="color:#888;text-align:center;margin-top:20px;">🎵 ' + filename + '</div>';
        } else if (['odt','doc','docx'].includes(ext)) {
            content.innerHTML = '<div style="color:#888;text-align:center;padding:40px;">📄 Documento Office<br><br>Use o botão Download para abrir no seu editor preferido</div>';
        } else if (['xls','xlsx','csv'].includes(ext)) {
            content.innerHTML = '<div style="color:#888;text-align:center;padding:40px;"> Planilha<br><br>Use o botão Download para abrir no seu editor preferido</div>';
        } else {
            content.innerHTML = '<div style="color:#888;text-align:center;padding:40px;">📄 Formato não suportado para visualização<br><br>Use o botão Download</div>';
        }
        
        document.getElementById('fm-viewer-close').onclick = window.closeViewerFM;
        document.getElementById('fm-viewer-dl').onclick = function() {
            window.open('/api/files/download/' + encodeURIComponent(filename), '_blank');
        };
    }
};

window.closeViewerFM = function() {
    console.log("🔒 [FM] Fechando viewer...");
    var viewer = document.getElementById('fm-viewer');
    var content = document.getElementById('fm-viewer-content');
    
    if (viewer) {
        viewer.style.display = 'none';
        viewer.classList.remove('active');
    }
    if (content) content.innerHTML = '';
    
    document.querySelector('.fm-toolbar').style.display = 'flex';
    document.getElementById('fm-upload-area').style.display = 'flex';
    document.getElementById('fm-file-list').style.display = 'grid';
};

window.uploadFM = function(files) {
    if (!files || !files.length) return;
    var uploaded = 0;
    
    function uploadNext(i) {
        if (i >= files.length) {
            alert(uploaded + ' arquivo(s) enviado(s)');
            window.loadFM();
            return;
        }
        var fd = new FormData();
        fd.append('file', files[i]);
        fetch('/api/files/upload', {method:'POST', body:fd})
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success || data.status === 'success') uploaded++;
            uploadNext(i+1);
        });
    }
    uploadNext(0);
};

window.newFolder = function() {
    var name = prompt('Nome da pasta:');
    if (name) {
        fetch('/api/files/create', {
            method:'POST',
            headers:{'Content-Type':'application/json'},
            body:JSON.stringify({filename:name+'/.folder',content:'folder'})
        }).then(function() { window.loadFM(); });
    }
};

window.newFile = function() {
    var name = prompt('Nome do arquivo:');
    if (name) {
        fetch('/api/files/create', {
            method:'POST',
            headers:{'Content-Type':'application/json'},
            body:JSON.stringify({filename:name,content:''})
        }).then(function() { window.loadFM(); });
    }
};

// Drag and drop
document.addEventListener('DOMContentLoaded', function() {
    var area = document.getElementById('fm-upload-area');
    if (area) {
        area.addEventListener('dragover', function(e) {
            e.preventDefault();
            area.style.background = 'rgba(77,171,247,0.2)';
        });
        area.addEventListener('dragleave', function() {
            area.style.background = '';
        });
        area.addEventListener('drop', function(e) {
            e.preventDefault();
            area.style.background = '';
            var files = e.dataTransfer.files;
            if (files.length) window.uploadFM(files);
        });
    }
    
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') window.closeFM();
    });
    
    console.log("✅ [FM v7.0] Pronto!");
});
