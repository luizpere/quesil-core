<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>ThinkinOS Code Editor</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; padding: 0; background: #1e1e1e; color: #fff; font-family: sans-serif; height: 100vh; display: flex; flex-direction: column; overflow: hidden; }
        
        /* TOOLBAR SUPERIOR */
        .toolbar { background: #2d2d2d; padding: 8px 15px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #333; gap: 10px; flex-shrink: 0; }
        .file-controls { display: flex; align-items: center; gap: 10px; flex: 1; }
        select { background: #3c3c3c; color: #fff; border: 1px solid #555; padding: 6px 10px; border-radius: 4px; font-size: 13px; cursor: pointer; outline: none; }
        .btn { background: #0e639c; color: white; border: none; padding: 6px 16px; cursor: pointer; border-radius: 3px; font-size: 13px; opacity: 0.5; pointer-events: none; transition: all 0.3s; }
        .btn.ready { opacity: 1; pointer-events: auto; }
        .btn:hover { background: #1177bb; }
        .btn-diff { background: #d69e2e; }
        .btn-diff:hover { background: #ecc94b; }
        .btn-search { background: #6a1b9a; }
        .btn-search:hover { background: #8e24aa; }
        .btn-close { background: #cc3333; }
        .btn-close:hover { background: #dd4444; }
        
        /* ABAS DE ARQUIVOS */
        .tabs-bar { 
            background: #252526; display: flex; overflow-x: auto; border-bottom: 1px solid #333; 
            flex-shrink: 0; max-height: 35px; scrollbar-width: thin; scrollbar-color: #555 #252526;
        }
        .tab { 
            padding: 8px 20px 8px 15px; cursor: pointer; font-size: 13px; color: #969696; 
            border-right: 1px solid #333; display: flex; align-items: center; gap: 8px; 
            white-space: nowrap; user-select: none; position: relative; min-width: 120px;
        }
        .tab:hover { background: #2a2d2e; color: #fff; }
        .tab.active { background: #1e1e1e; color: #fff; border-bottom: 2px solid #0e639c; }
        .tab .close-tab { 
            font-size: 14px; opacity: 0; transition: opacity 0.2s; padding: 0 2px; border-radius: 3px;
        }
        .tab:hover .close-tab { opacity: 1; }
        .tab .close-tab:hover { background: #c75450; color: white; }
        .tab.modified::after { content: '●'; position: absolute; right: 8px; color: #fff; font-size: 10px; }
        
        /* ÁREA PRINCIPAL */
        .main-area { flex: 1; display: flex; flex-direction: column; overflow: hidden; position: relative; }
        #editor-wrapper { flex: 1; width: 100%; position: relative; }
        #container { width: 100%; height: 100%; }
        #fallback-editor { 
            display: none; width: 100%; height: 100%; background: #1e1e1e; color: #d4d4d4; 
            border: none; padding: 10px; font-family: monospace; font-size: 14px; 
            resize: none; outline: none; box-sizing: border-box;
        }
        
        /* TERMINAL INTEGRADO */
        .terminal-panel { 
            height: 0; background: #1e1e1e; border-top: 1px solid #333; 
            display: flex; flex-direction: column; transition: height 0.3s ease; overflow: hidden; flex-shrink: 0;
        }
        .terminal-panel.open { height: 250px; }
        .terminal-header { 
            background: #2d2d2d; padding: 5px 15px; display: flex; justify-content: space-between; 
            align-items: center; font-size: 12px; border-bottom: 1px solid #333; flex-shrink: 0;
        }
        .terminal-header span { color: #ccc; }
        .terminal-body { flex: 1; overflow-y: auto; padding: 10px; font-family: monospace; font-size: 13px; color: #0f0; }
        .terminal-input-line { display: flex; padding: 5px 10px; background: #1a1a1a; border-top: 1px solid #333; flex-shrink: 0; }
        .terminal-prompt { color: #0f0; margin-right: 8px; white-space: nowrap; }
        #terminal-input { 
            flex: 1; background: transparent; border: none; color: #fff; font-family: monospace; 
            font-size: 13px; outline: none; caret-color: #0f0;
        }
        
        /* BARRA DE STATUS */
        .status-bar { background: #007acc; color: white; padding: 4px 15px; font-size: 12px; display: flex; justify-content: space-between; flex-shrink: 0; }
        
        /* MODAIS */
        .modal-overlay { 
            display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; 
            background: rgba(0,0,0,0.7); z-index: 1000; justify-content: center; align-items: center; 
        }
        .modal-content { background: #252526; border-radius: 8px; overflow: hidden; display: flex; flex-direction: column; max-width: 80%; max-height: 80%; }
        
        /* MODAL DIFF */
        .diff-modal .modal-content { width: 90%; height: 80%; }
        .diff-header { background: #333; padding: 10px 15px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #444; }
        .diff-body { flex: 1; display: flex; overflow: auto; }
        .diff-pane { flex: 1; padding: 10px; font-family: monospace; font-size: 13px; white-space: pre-wrap; overflow: auto; line-height: 1.5; }
        .diff-old { background: #2a1f1f; color: #ff7b72; border-right: 1px solid #444; }
        .diff-new { background: #1f2a1f; color: #7ee787; }
        .diff-line { padding: 2px 5px; margin: 1px 0; border-left: 3px solid transparent; }
        .diff-added { background: rgba(126, 231, 135, 0.1); border-left-color: #7ee787; }
        .diff-removed { background: rgba(255, 123, 114, 0.1); border-left-color: #ff7b72; }
        
        /* MODAL BUSCA */
        .search-modal .modal-content { width: 600px; max-height: 500px; }
        .search-header { background: #333; padding: 15px; border-bottom: 1px solid #444; }
        .search-input { 
            width: 100%; background: #3c3c3c; color: #fff; border: 1px solid #555; 
            padding: 10px; border-radius: 4px; font-size: 14px; outline: none;
        }
        .search-input:focus { border-color: #0e639c; }
        .search-results { flex: 1; overflow-y: auto; padding: 10px; }
        .search-result-item { 
            padding: 10px; border-bottom: 1px solid #333; cursor: pointer; 
        }
        .search-result-item:hover { background: #2a2d2e; }
        .search-result-file { color: #0e639c; font-weight: bold; margin-bottom: 5px; }
        .search-result-context { color: #ccc; font-family: monospace; font-size: 12px; white-space: pre-wrap; word-break: break-all; }
        .search-highlight { background: #ffeb3b; color: #000; padding: 1px 3px; border-radius: 2px; }
        
        #error-msg { 
            display: none; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); 
            background: #333; padding: 20px; border-radius: 8px; text-align: center; max-width: 400px; z-index: 10;
        }
    </style>
</head>
<body>
    <!-- TOOLBAR -->
    <div class="toolbar">
        <div class="file-controls">
            <span style="color:#ccc;">📄</span>
            <select id="file-selector" onchange="openFile(this.value)">
                <option value="">Abrir arquivo...</option>
                <option value="app.py">app.py</option>
                <option value="assistants.json">assistants.json</option>
                <option value="templates/desktop.html">desktop.html</option>
                <option value="templates/terminal_native.html">terminal_native.html</option>
                <option value="templates/editor.html">editor.html</option>
                <option value="static/css/glassmorphism.css"> glassmorphism.css</option>
                <option value="static/git_integration.js"> git_integration.js</option>
            </select>
        </div>
        <div style="display:flex; gap:8px;">
            <button id="btn-terminal" class="btn ready" onclick="toggleTerminal()">💻 Terminal</button>
            <button id="btn-search" class="btn btn-search ready" onclick="openSearch()"> Buscar</button>
            <button id="btn-diff" class="btn btn-diff ready" onclick="showDiff()">📊 Comparar</button>
            <button id="btn-save" class="btn ready" onclick="saveCurrentTab()">💾 Salvar</button>
            <button class="btn btn-close ready" onclick="window.close()">✕ Fechar</button>
        </div>
    </div>
    
    <!-- ABAS -->
    <div class="tabs-bar" id="tabs-bar"></div>
    
    <!-- ÁREA PRINCIPAL -->
    <div class="main-area">
        <div id="editor-wrapper">
            <div id="container"></div>
            <textarea id="fallback-editor" placeholder="Editor Monaco falhou. Usando modo texto simples..."></textarea>
            <div id="error-msg">
                <h3>⚠️ Erro ao carregar editor</h3>
                <p id="error-detail"></p>
                <button class="btn ready" onclick="location.reload()" style="margin-top:10px;">🔄 Recarregar</button>
            </div>
        </div>
        
        <!-- TERMINAL INTEGRADO -->
        <div class="terminal-panel" id="terminal-panel">
            <div class="terminal-header">
                <span>💻 Terminal Integrado</span>
                <button class="btn btn-close ready" onclick="toggleTerminal()" style="padding:2px 10px; font-size:11px;"></button>
            </div>
            <div class="terminal-body" id="terminal-output"></div>
            <div class="terminal-input-line">
                <span class="terminal-prompt">luperesil@thinkinos:~$</span>
                <input type="text" id="terminal-input" autocomplete="off" spellcheck="false" placeholder="Digite um comando...">
            </div>
        </div>
    </div>
    
    <!-- BARRA DE STATUS -->
    <div class="status-bar">
        <span id="status-msg">Carregando...</span>
        <span>ThinkinOS Code Editor V2.0 | Abas • Busca Global • Terminal</span>
    </div>

    <!-- MODAL DIFF -->
    <div id="diff-modal" class="modal-overlay diff-modal" onclick="if(event.target===this)closeModal('diff-modal')">
        <div class="modal-content">
            <div class="diff-header">
                <span style="font-weight:bold;">📊 Comparação: <span id="diff-filename"></span></span>
                <button class="btn btn-close ready" onclick="closeModal('diff-modal')" style="padding:4px 12px;">✕</button>
            </div>
            <div class="diff-body">
                <div class="diff-pane diff-old" id="diff-old"></div>
                <div class="diff-pane diff-new" id="diff-new"></div>
            </div>
        </div>
    </div>

    <!-- MODAL BUSCA -->
    <div id="search-modal" class="modal-overlay search-modal" onclick="if(event.target===this)closeModal('search-modal')">
        <div class="modal-content">
            <div class="search-header">
                <input type="text" class="search-input" id="search-input" placeholder="Buscar em todos os arquivos..." onkeyup="if(event.key==='Enter')performSearch()">
            </div>
            <div class="search-results" id="search-results"></div>
        </div>
    </div>

    <!-- SCRIPTS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.44.0/min/vs/loader.min.js"></script>
    <script>
        // ===== ESTADO GLOBAL =====
        let editor = null;
        let useFallback = false;
        let tabs = []; // [{file, content, modified}]
        let activeTabIndex = -1;
        let terminalHistory = [];
        let terminalHistoryIndex = -1;
        
        const langMap = {'.py':'python','.js':'javascript','.html':'html','.json':'json','.css':'css','.sh':'shell'};
        function getLanguage(f) { return langMap['.'+f.split('.').pop()] || 'plaintext'; }
        
        // ===== INICIALIZAÇÃO =====
        const loadTimeout = setTimeout(() => {
            if (!editor && !useFallback) activateFallback("Tempo esgotado ao carregar Monaco.");
        }, 5000);
        
        function enableButtons() {
            document.querySelectorAll('.btn').forEach(b => b.classList.add('ready'));
            clearTimeout(loadTimeout);
        }
        
        function activateFallback(reason) {
            useFallback = true;
            document.getElementById('container').style.display = 'none';
            document.getElementById('fallback-editor').style.display = 'block';
            document.getElementById('error-msg').style.display = 'block';
            document.getElementById('error-detail').textContent = reason;
            document.getElementById('status-msg').textContent = 'Modo texto simples';
            enableButtons();
        }
        
        try {
            require.config({ paths: { 'vs': 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.44.0/min/vs' }});
            require(['vs/editor/editor.main'], function() {
                clearTimeout(loadTimeout);
                console.log("✅ Monaco carregado");
                try {
                    editor = monaco.editor.create(document.getElementById('container'), {
                        value: '// Selecione um arquivo para começar', language: 'plaintext', theme: 'vs-dark',
                        automaticLayout: true, fontSize: 14, minimap: {enabled:true}, scrollBeyondLastLine: false, tabSize: 4
                    });
                    enableButtons();
                    document.getElementById('status-msg').textContent = 'Pronto - Abra um arquivo';
                    
                    // Abrir app.py por padrão se disponível
                    openFile('app.py');
                } catch(e) { activateFallback("Erro Monaco: " + e.message); }
            }, function(err) { activateFallback("Falha CDN Monaco."); });
        } catch(e) { activateFallback("Erro crítico: " + e.message); }
        
        // ===== SISTEMA DE ABAS =====
        function renderTabs() {
            const bar = document.getElementById('tabs-bar');
            bar.innerHTML = '';
            tabs.forEach((tab, i) => {
                const el = document.createElement('div');
                el.className = 'tab' + (i === activeTabIndex ? ' active' : '') + (tab.modified ? ' modified' : '');
                el.innerHTML = `<span>${tab.file}</span><span class="close-tab" onclick="event.stopPropagation();closeTab(${i})">×</span>`;
                el.onclick = () => switchTab(i);
                bar.appendChild(el);
            });
        }
        
        async function openFile(file) {
            if (!file) return;
            
            // Verificar se já está aberto
            const existing = tabs.findIndex(t => t.file === file);
            if (existing !== -1) { switchTab(existing); return; }
            
            document.getElementById('status-msg').textContent = `Carregando ${file}...`;
            try {
                const res = await fetch(`/api/file/read?file=${encodeURIComponent(file)}`);
                const data = await res.json();
                if (data.error) { alert(`Erro: ${data.error}`); return; }
                
                tabs.push({ file, content: data.content, modified: false });
                activeTabIndex = tabs.length - 1;
                renderTabs();
                updateEditor();
                document.getElementById('status-msg').textContent = `Aberto: ${file}`;
            } catch(e) { alert(`Falha: ${e.message}`); }
        }
        
        function switchTab(index) {
            if (index < 0 || index >= tabs.length) return;
            // Salvar conteúdo atual antes de trocar
            if (activeTabIndex >= 0 && tabs[activeTabIndex]) {
                tabs[activeTabIndex].content = getContent();
            }
            activeTabIndex = index;
            renderTabs();
            updateEditor();
            document.getElementById('status-msg').textContent = `Arquivo: ${tabs[index].file}`;
        }
        
        function closeTab(index) {
            if (tabs[index].modified && !confirm(`"${tabs[index].file}" tem alterações não salvas. Fechar mesmo assim?`)) return;
            tabs.splice(index, 1);
            if (activeTabIndex >= tabs.length) activeTabIndex = tabs.length - 1;
            if (tabs.length === 0) {
                activeTabIndex = -1;
                setContent('// Selecione um arquivo para começar');
            } else {
                renderTabs();
                updateEditor();
            }
        }
        
        function updateEditor() {
            if (activeTabIndex >= 0 && tabs[activeTabIndex]) {
                setContent(tabs[activeTabIndex].content);
                if (editor && !useFallback) {
                    editor.setModel(monaco.editor.createModel(tabs[activeTabIndex].content, getLanguage(tabs[activeTabIndex].file)));
                }
            }
        }
        
        function markModified() {
            if (activeTabIndex >= 0 && tabs[activeTabIndex]) {
                tabs[activeTabIndex].modified = true;
                tabs[activeTabIndex].content = getContent();
                renderTabs();
            }
        }
        
        // ===== CONTEÚDO DO EDITOR =====
        function setContent(text) {
            if (useFallback || !editor) {
                document.getElementById('fallback-editor').value = text;
            } else {
                editor.setValue(text);
            }
        }
        
        function getContent() {
            if (useFallback || !editor) return document.getElementById('fallback-editor').value;
            return editor.getValue();
        }
        
        // Monitorar mudanças no editor
        setInterval(() => {
            if (activeTabIndex >= 0 && tabs[activeTabIndex]) {
                const current = getContent();
                if (current !== tabs[activeTabIndex].content) {
                    tabs[activeTabIndex].modified = true;
                    tabs[activeTabIndex].content = current;
                    renderTabs();
                }
            }
        }, 500);
        
        // ===== SALVAR =====
        async function saveCurrentTab() {
            if (activeTabIndex < 0 || !tabs[activeTabIndex]) return;
            const tab = tabs[activeTabIndex];
            const content = getContent();
            document.getElementById('status-msg').textContent = 'Salvando...';
            try {
                const res = await fetch('/api/file/save', {
                    method:'POST', headers:{'Content-Type':'application/json'},
                    body: JSON.stringify({file: tab.file, content})
                });
                const data = await res.json();
                if (data.success) {
                    tab.modified = false;
                    tab.content = content;
                    renderTabs();
                    document.getElementById('status-msg').textContent = `✅ ${data.message}`;
                    setTimeout(() => document.getElementById('status-msg').textContent = 'Pronto', 3000);
                } else {
                    document.getElementById('status-msg').textContent = `❌ ${data.error}`;
                }
            } catch(e) { document.getElementById('status-msg').textContent = `❌ Erro: ${e.message}`; }
        }
        
        // ===== DIFF VISUAL =====
        async function showDiff() {
            if (activeTabIndex < 0 || !tabs[activeTabIndex]) { alert('Nenhum arquivo aberto.'); return; }
            const tab = tabs[activeTabIndex];
            const bakFile = tab.file + '.bak';
            document.getElementById('status-msg').textContent = 'Carregando backup...';
            
            try {
                const resBak = await fetch(`/api/file/read?file=${encodeURIComponent(bakFile)}`);
                const dataBak = await resBak.json();
                if (dataBak.error) {
                    alert('Nenhum backup encontrado. Salve pelo menos uma vez antes de comparar.');
                    document.getElementById('status-msg').textContent = 'Pronto';
                    return;
                }
                
                const diffs = simpleDiff(dataBak.content, getContent());
                let oldHtml = '', newHtml = '';
                diffs.forEach(d => {
                    const safe = d.text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\t/g,'    ');
                    if (d.type === -1) oldHtml += `<div class="diff-line diff-removed">-${safe}</div>`;
                    else if (d.type === 1) newHtml += `<div class="diff-line diff-added">+${safe}</div>`;
                    else { oldHtml += `<div class="diff-line">${safe}</div>`; newHtml += `<div class="diff-line">${safe}</div>`; }
                });
                
                document.getElementById('diff-old').innerHTML = oldHtml || '<div style="padding:20px;color:#666;">Sem remoções</div>';
                document.getElementById('diff-new').innerHTML = newHtml || '<div style="padding:20px;color:#666;">Sem adições</div>';
                document.getElementById('diff-filename').textContent = tab.file;
                document.getElementById('diff-modal').style.display = 'flex';
                document.getElementById('status-msg').textContent = 'Comparando...';
            } catch(e) { alert('Erro diff: ' + e.message); }
        }
        
        function simpleDiff(oldText, newText) {
            const oldLines = oldText.split('\n'), newLines = newText.split('\n'), result = [];
            let i = 0, j = 0;
            while (i < oldLines.length || j < newLines.length) {
                if (i < oldLines.length && j < newLines.length && oldLines[i] === newLines[j]) {
                    result.push({type:0, text:oldLines[i]}); i++; j++;
                } else if (j < newLines.length && (i >= oldLines.length || newLines[j] !== oldLines[i])) {
                    let found = false;
                    for(let k=i+1; k<Math.min(i+5, oldLines.length); k++) { if(oldLines[k]===newLines[j]){found=true;break;} }
                    if(!found && i < oldLines.length) { result.push({type:-1,text:oldLines[i]}); i++; }
                    else { result.push({type:1,text:newLines[j]}); j++; }
                } else if (i < oldLines.length) { result.push({type:-1,text:oldLines[i]}); i++; }
            }
            return result;
        }
        
        // ===== BUSCA GLOBAL =====
        async function openSearch() {
            document.getElementById('search-modal').style.display = 'flex';
            document.getElementById('search-input').value = '';
            document.getElementById('search-results').innerHTML = '<div style="padding:20px;color:#666;text-align:center;">Digite um termo e pressione Enter</div>';
            setTimeout(() => document.getElementById('search-input').focus(), 100);
        }
        
        async function performSearch() {
            const query = document.getElementById('search-input').value.trim();
            if (!query) return;
            
            const resultsDiv = document.getElementById('search-results');
            resultsDiv.innerHTML = '<div style="padding:20px;color:#666;text-align:center;">Buscando...</div>';
            
            const files = ['app.py','assistants.json','templates/desktop.html','templates/terminal_native.html','templates/editor.html'];
            let allResults = [];
            
            for (const file of files) {
                try {
                    const res = await fetch(`/api/file/read?file=${encodeURIComponent(file)}`);
                    const data = await res.json();
                    if (data.content) {
                        const lines = data.content.split('\n');
                        lines.forEach((line, idx) => {
                            if (line.toLowerCase().includes(query.toLowerCase())) {
                                allResults.push({file, line: idx+1, text: line});
                            }
                        });
                    }
                } catch(e) {}
            }
            
            if (allResults.length === 0) {
                resultsDiv.innerHTML = '<div style="padding:20px;color:#666;text-align:center;">Nenhum resultado encontrado</div>';
                return;
            }
            
            resultsDiv.innerHTML = allResults.map(r => {
                const highlighted = r.text.replace(new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')})`, 'gi'), '<span class="search-highlight">$1</span>');
                return `<div class="search-result-item" onclick="openFile('${r.file}');closeModal('search-modal')">
                    <div class="search-result-file">${r.file} (linha ${r.line})</div>
                    <div class="search-result-context">${highlighted}</div>
                </div>`;
            }).join('');
            
            document.getElementById('status-msg').textContent = `${allResults.length} resultados encontrados`;
        }
        
        // ===== TERMINAL INTEGRADO =====
        function toggleTerminal() {
            const panel = document.getElementById('terminal-panel');
            panel.classList.toggle('open');
            if (panel.classList.contains('open')) {
                document.getElementById('terminal-input').focus();
                addTerminalOutput('ThinkinOS Terminal Integrado v1.0\nDigite "help" para ver comandos disponíveis.\n');
            }
        }
        
        function addTerminalOutput(text) {
            const output = document.getElementById('terminal-output');
            output.innerHTML += text.replace(/\n/g, '<br>');
            output.scrollTop = output.scrollHeight;
        }
        
        document.getElementById('terminal-input').addEventListener('keydown', async function(e) {
            if (e.key === 'Enter') {
                const cmd = this.value.trim();
                if (!cmd) return;
                
                terminalHistory.push(cmd);
                terminalHistoryIndex = terminalHistory.length;
                addTerminalOutput(`<span style="color:#0f0;">luperesil@thinkinos:~$</span> ${cmd}\n`);
                this.value = '';
                
                // Processar comandos localmente
                const response = await processTerminalCommand(cmd);
                addTerminalOutput(response + '\n');
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                if (terminalHistoryIndex > 0) {
                    terminalHistoryIndex--;
                    this.value = terminalHistory[terminalHistoryIndex];
                }
            } else if (e.key === 'ArrowDown') {
                e.preventDefault();
                if (terminalHistoryIndex < terminalHistory.length - 1) {
                    terminalHistoryIndex++;
                    this.value = terminalHistory[terminalHistoryIndex];
                } else {
                    terminalHistoryIndex = terminalHistory.length;
                    this.value = '';
                }
            }
        });
        
        async function processTerminalCommand(cmd) {
            const parts = cmd.split(' ');
            const command = parts[0].toLowerCase();
            
            switch(command) {
                case 'help':
                    return `Comandos disponíveis:
  help          - Mostrar esta ajuda
  ls [dir]      - Listar arquivos
  cat <file>    - Mostrar conteúdo do arquivo
  pwd           - Diretório atual
  date          - Data e hora
  clear         - Limpar terminal
  echo <text>   - Imprimir texto
  whoami        - Usuário atual
  save          - Salvar aba atual
  open <file>   - Abrir arquivo no editor`;
                
                case 'ls':
                    try {
                        const res = await fetch('/api/file/read?file=.');
                        // Simular listagem com arquivos conhecidos
                        return `app.py          assistants.json     templates/
auto_backup.sh  chat_history.db   thinkinos.db
backup_thinkinos.py  cleanup.py      uploads/
static/         venv/             .env`;
                    } catch(e) { return 'Erro ao listar arquivos'; }
                
                case 'pwd':
                    return '/home/lps/thinkinos-platform';
                
                case 'date':
                    return new Date().toString();
                
                case 'whoami':
                    return 'luperesil';
                
                case 'clear':
                    document.getElementById('terminal-output').innerHTML = '';
                    return '';
                
                case 'echo':
                    return parts.slice(1).join(' ');
                
                case 'cat':
                    if (!parts[1]) return 'Uso: cat <arquivo>';
                    try {
                        const res = await fetch(`/api/file/read?file=${encodeURIComponent(parts[1])}`);
                        const data = await res.json();
                        return data.content || data.error || 'Arquivo não encontrado';
                    } catch(e) { return 'Erro ao ler arquivo'; }
                
                case 'save':
                    await saveCurrentTab();
                    return 'Arquivo salvo!';
                
                case 'open':
                    if (!parts[1]) return 'Uso: open <arquivo>';
                    openFile(parts[1]);
                    return `Abrindo ${parts[1]}...`;
                
                default:
                    return `Comando não encontrado: ${command}. Digite "help" para ver comandos disponíveis.`;
            }
        }
        
        // ===== UTILITÁRIOS =====
        function closeModal(id) { document.getElementById(id).style.display = 'none'; }
        
        // Atalhos de teclado
        document.addEventListener('keydown', (e) => {
            if ((e.ctrlKey||e.metaKey) && e.key==='s') { e.preventDefault(); saveCurrentTab(); }
            if ((e.ctrlKey||e.metaKey) && e.key==='f') { e.preventDefault(); openSearch(); }
            if ((e.ctrlKey||e.metaKey) && e.key==='`') { e.preventDefault(); toggleTerminal(); }
            if (e.key === 'Escape') {
                document.querySelectorAll('.modal-overlay').forEach(m => m.style.display = 'none');
            }
        });
    </script>
