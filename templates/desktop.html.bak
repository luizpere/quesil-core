<script>
document.addEventListener('DOMContentLoaded', () => {
    if (typeof io !== 'undefined') {
        const previewSocket = io();
        
        previewSocket.on('file_saved', (data) => {
            console.log(`🔄 Arquivo salvo: ${data.file}`);
            
            const relevantFiles = ['templates/desktop.html', 'templates/terminal_native.html'];
            
            if (relevantFiles.includes(data.file)) {
                const notif = document.createElement('div');
                notif.style.cssText = 'position:fixed;top:20px;right:20px;background:#007acc;color:white;padding:10px 20px;border-radius:4px;z-index:9999;font-size:14px;box-shadow:0 2px 8px rgba(0,0,0,0.3);';
                notif.textContent = `🔄 ${data.file} atualizado! Recarregando...`;
                document.body.appendChild(notif);
                
                setTimeout(() => {
                    window.location.reload();
                }, 1000);
            }
        });
        
        console.log("✅ Live Preview listener ativo");
    } else {
        console.warn("⚠️ SocketIO não disponível para Live Preview");
    }
});
</script>


<script>
// LIVE PREVIEW: Recarregar desktop quando arquivos HTML forem salvos no Editor
document.addEventListener('DOMContentLoaded', () => {
    console.log("🔍 [LIVE PREVIEW] Verificando SocketIO para Live Preview...");
    
    // Aguardar um pouco para garantir que socket.io carregou
    setTimeout(() => {
        if (typeof io !== 'undefined') {
            console.log("✅ [LIVE PREVIEW] SocketIO encontrado! Conectando...");
            const previewSocket = io();
            
            previewSocket.on('connect', () => {
                console.log(" Conectado ao servidor WebSocket para Live Preview");
            });
            
            previewSocket.on('file_saved', (data) => {
                console.log(` Evento recebido: ${JSON.stringify(data)}`);
                
                // Lista de arquivos que afetam o desktop
                const relevantFiles = ['templates/desktop.html', 'templates/terminal_native.html', 'static/style.css'];
                
                if (relevantFiles.includes(data.file)) {
                    console.log(`🔄 Arquivo relevante salvo: ${data.file}. Recarregando...`);
                    
                    // Mostrar notificação sutil antes de recarregar
                    const notif = document.createElement('div');
                    notif.style.cssText = 'position:fixed;top:20px;right:20px;background:#007acc;color:white;padding:10px 20px;border-radius:4px;z-index:9999;font-size:14px;box-shadow:0 2px 8px rgba(0,0,0,0.3);animation:fadeIn 0.3s;';
                    notif.textContent = `🔄 ${data.file} atualizado! Recarregando...`;
                    document.body.appendChild(notif);
                    
                    // Recarregar após 1.5 segundos
                    setTimeout(() => {
                        window.location.reload();
                    }, 1500);
                }
            });
            
            previewSocket.on('disconnect', () => {
                console.log("❌ Desconectado do servidor WebSocket");
            });
            
        } else {
            console.error(" SocketIO NÃO disponível! Verifique se o script foi carregado.");
        }
    }, 500); // Pequeno delay para garantir carregamento
});
</script>


<script>
// HOT RELOAD INTELIGENTE: Complemento ao Live Preview existente
(function() {
    'use strict';
    
    // Aguardar SocketIO do Live Preview já estar conectado
    setTimeout(() => {
        if (typeof io !== 'undefined') {
            console.log(" [HOT RELOAD] Adicionando handlers inteligentes...");
            
            const hotSocket = io();
            
            hotSocket.on('file_saved', (data) => {
                const filename = data.file;
                const filetype = data.type || (filename.endsWith('.css') ? 'css' : filename.endsWith('.js') ? 'js' : 'html');
                
                // CSS: Atualização dinâmica sem reload
                if (filetype === 'css') {
                    console.log(`🎨 [HOT RELOAD] CSS detectado: ${filename}`);
                    handleCSSUpdate(filename);
                }
                // JS: Execução dinâmica
                else if (filetype === 'js') {
                    console.log(` [HOT RELOAD] JS detectado: ${filename}`);
                    handleJSUpdate(filename);
                }
                // HTML: Deixar o Live Preview existente cuidar do reload
                else if (filetype === 'html') {
                    console.log(` [HOT RELOAD] HTML - Live Preview existente cuidará do reload`);
                }
            });
        }
    }, 1000); // Aguardar 1s para garantir que Live Preview já conectou
    
    function handleCSSUpdate(filename) {
        fetch(`/${filename}?t=${Date.now()}`)
            .then(response => response.text())
            .then(cssText => {
                let styleTag = document.getElementById(`hot-reload-${filename}`);
                if (!styleTag) {
                    styleTag = document.createElement('style');
                    styleTag.id = `hot-reload-${filename}`;
                    document.head.appendChild(styleTag);
                }
                styleTag.textContent = cssText;
                console.log(`✅ [CSS] ${filename} atualizado (${cssText.length} bytes)`);
            })
            .catch(err => console.error(`❌ [CSS] Erro: ${err}`));
    }
    
    function handleJSUpdate(filename) {
        fetch(`/${filename}?t=${Date.now()}`)
            .then(response => response.text())
            .then(jsText => {
                const oldScript = document.getElementById(`hot-reload-${filename}`);
                if (oldScript) oldScript.remove();
                
                const newScript = document.createElement('script');
                newScript.id = `hot-reload-${filename}`;
                newScript.textContent = jsText;
                document.body.appendChild(newScript);
                console.log(`✅ [JS] ${filename} executado`);
            })
            .catch(err => console.error(` [JS] Erro: ${err}`));
    }
})();
</script>

</body>
</html>
