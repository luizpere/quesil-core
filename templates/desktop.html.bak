</head>
<body>
    <div class="header">
        <h1>ThinkinOS <span style="color: #4caf50;">v2.0</span></h1>
        <div style="position: absolute; top: 20px; right: 120px; color: #fff; font-size: 1.1em; font-family: 'Courier New', monospace;" id="clock">00:00:00</div>
        <button class="logout-btn" onclick="location.href='/logout'">Sair</button>
    </div>
    
    <div id="assistants-container" class="grid"></div>

    <!-- DOCK -->
    <div class="dock">
        <a class="dock-item" href="/desktop"><span class="dock-icon">🏠</span><span class="dock-label">Início</span></a>
        <a class="dock-item" onclick="showComingSoon('Arquivos')"><span class="dock-icon">📁</span><span class="dock-label">Arquivos</span></a>
        <a class="dock-item" onclick="openChat('Ana')"><span class="dock-icon">💬</span><span class="dock-label">Chat</span></a>
        <a class="dock-item" href="/perfil"><span class="dock-icon">👤</span><span class="dock-label">Perfil</span></a>
        <a class="dock-item" onclick="showComingSoon('Gestão')"><span class="dock-icon">⚙️</span><span class="dock-label">Gestão</span></a>
        <a class="dock-item" onclick="showComingSoon('Novo Assistente')"><span class="dock-icon">➕</span><span class="dock-label">Novo</span></a>
    </div>

    <!-- VM MODAL -->
    <div class="vm-overlay" id="vm-overlay" onclick="closeVMManager()"></div>
    <div class="vm-modal" id="vm-modal">
        <div class="vm-header">
            <h2> Gerenciador de Máquinas Virtuais</h2>
            <button class="close-btn" onclick="closeVMManager()">&times;</button>
        </div>
        <div class="vm-actions">
            <button class="btn btn-primary" onclick="startVM('alpine')">▶ Ligar Alpine</button>
            <button class="btn btn-primary" onclick="startVM('ubuntu')" style="background: #E95420;">▶ Ligar Ubuntu</button>
            <button class="btn" onclick="loadVMs()" style="background: #555; color: white;">🔄 Atualizar</button>
        </div>
        <div class="vm-list" id="vm-list"><p style="text-align: center; color: #888;">Carregando...</p></div>
    </div>

    

<!-- Modal do Terminal Web -->
<div class="vm-overlay" id="terminal-overlay" onclick="closeTerminal()"></div>
<div class="vm-modal" id="terminal-modal" style="max-width: 1000px;">
    <div class="vm-header">
        <h2>💻 Terminal - <span id="terminal-container-name">Container</span></h2>
        <button class="close-btn" onclick="closeTerminal()">&times;</button>
    </div>
    <div id="terminal-container" style="height: 500px; background: #000; padding: 10px; border-radius: 4px;"></div>
</div>


<!-- Modal de Chat Funcional -->
<div class="vm-overlay" id="chat-overlay" onclick="closeChatModal()"></div>
<div class="vm-modal" id="chat-modal" style="max-width: 800px;">
    <div class="vm-header">
        <h2>💬 Chat com <span id="chat-assistant-name">Assistente</span></h2>
        <button class="close-btn" onclick="closeChatModal()">&times;</button>
    </div>
    <div id="chat-messages" style="height: 400px; overflow-y: auto; background: #0a0a0a; padding: 15px; border-radius: 4px; margin-bottom: 10px;"></div>
    <div style="display: flex; gap: 10px;">
        <input type="text" id="chat-input" placeholder="Digite sua mensagem..." 
               style="flex: 1; padding: 10px; border-radius: 4px; border: 1px solid #444; background: #1a1a1a; color: #fff;"
               onkeypress="if(event.key === 'Enter') sendChatMessage()">
        <button class="btn btn-primary" onclick="sendChatMessage()">Enviar</button>
    </div>
</div>


<script>
// === VARIÁVEIS GLOBAIS ===
let currentAssistant = 'Ana';
let conversationHistory = [];

// === CARREGAMENTO DE ASSISTENTES ===
async function loadAssistants() {
    try {
        const resp = await fetch('/api/assistants');
        const assistants = await resp.json();
        console.log("ASSISTENTES:", assistants.length);
        
        const container = document.getElementById('assistants-container');
        container.innerHTML = '';
        
        assistants.forEach(agent => {
            const card = document.createElement('div');
            card.className = 'card';
            card.style.borderLeftColor = agent.color || '#4caf50';
            card.innerHTML = `
                <div class="card-header">
                    <div class="card-title">${agent.display_name || agent.name}</div>
                    <div>${agent.icon || ''}</div>
                </div>
                <div class="card-category">${agent.profile === 'custom' ? 'PERSONALIZADO' : 'GERAL'}</div>
                <div class="card-desc">${(agent.description || agent.prompt || '').substring(0, 100)}...</div>
            `;
            card.onclick = () => openChat(agent.display_name || agent.name);
            container.appendChild(card);
        });
        
        // Card de VMs
        const vmCard = document.createElement('div');
        vmCard.className = 'card';
        vmCard.style.borderLeftColor = '#0db7ed';
        vmCard.innerHTML = `
            <div class="card-header"><div class="card-title">Máquinas Virtuais</div><div>🐧</div></div>
        
        <!-- Card Dashboard V5.0 -->
            </div>
            <div class="card-category">SISTEMA</div>
        </div>

            <div class="card-category">Virtualização</div>
            <div class="card-desc">Gerencie containers Linux diretamente pelo ThinkinOS.</div>
        `;
        vmCard.onclick = openVMManager;
        container.appendChild(vmCard);
        
        console.log("Total de cards:", document.querySelectorAll('.card').length);
    } catch (e) {
        console.error("Erro ao carregar assistentes:", e);
    }
}

// === SISTEMA DE CHAT ===
function openChat(assistant) {
    console.log("Abrindo chat com:", assistant);
    currentAssistant = assistant;
    conversationHistory = [];
    document.getElementById('chat-assistant-name').textContent = assistant;
    document.getElementById('chat-modal').classList.add('active');
    document.getElementById('chat-overlay').classList.add('active');
    document.getElementById('chat-messages').innerHTML = '<div style="text-align: center; color: #888; padding: 20px;">Conversando com ' + assistant + '<br><small>Digite uma mensagem para começar</small></div>';
    document.getElementById('chat-input').value = '';
    document.getElementById('chat-input').focus();
}

function closeChatModal() {
    document.getElementById('chat-modal').classList.remove('active');
    document.getElementById('chat-overlay').classList.remove('active');
}

async function sendChatMessage() {
    const input = document.getElementById('chat-input');
    const message = input.value.trim();
    if (!message) return;
    
    const messagesDiv = document.getElementById('chat-messages');
    
    // Adicionar mensagem do usuário
    messagesDiv.innerHTML += '<div style="margin: 10px 0; text-align: right;"><span style="background: #2196F3; color: white; padding: 8px 12px; border-radius: 8px; display: inline-block;">' + message + '</span></div>';
    input.value = '';
    messagesDiv.scrollTop = messagesDiv.scrollHeight;
    
    // Adicionar indicador de digitação
    messagesDiv.innerHTML += '<div id="typing-indicator" style="margin: 10px 0; color: #888;">' + currentAssistant + ' está digitando...</div>';
    messagesDiv.scrollTop = messagesDiv.scrollHeight;
    
    try {
        const resp = await fetch('/api/chat', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({
                message: message,
                assistant: currentAssistant,
                history: conversationHistory
            })
        });
        const data = await resp.json();
        
        // Remover indicador
        const typing = document.getElementById('typing-indicator');
        if (typing) typing.remove();
        
        // Adicionar resposta
        const response = data.response || data.message || 'Sem resposta';
        messagesDiv.innerHTML += '<div style="margin: 10px 0; text-align: left;"><span style="background: #333; color: #fff; padding: 8px 12px; border-radius: 8px; display: inline-block;">' + response + '</span></div>';
        messagesDiv.scrollTop = messagesDiv.scrollHeight;
        
        // Salvar no histórico
        conversationHistory.push({role: 'user', content: message});
        conversationHistory.push({role: 'assistant', content: response});
    } catch (e) {
        const typing = document.getElementById('typing-indicator');
        if (typing) typing.remove();
        messagesDiv.innerHTML += '<div style="color: #f44336;">Erro ao enviar mensagem</div>';
        console.error("Erro no chat:", e);
    }
}

// === GERENCIADOR DE VMs ===
function openVMManager() {
    document.getElementById('vm-modal').classList.add('active');
    document.getElementById('vm-overlay').classList.add('active');
    loadVMs();
}

function closeVMManager() {
    document.getElementById('vm-modal').classList.remove('active');
    document.getElementById('vm-overlay').classList.remove('active');
}

async function startVM(distro) {
    try {
        const resp = await fetch('/api/vm/start/' + distro, { method: 'POST' });
        const data = await resp.json();
        alert(data.message || data.error);
        loadVMs();
    } catch (e) {
        alert("Erro de conexão");
    }
}

async function loadVMs() {
    try {
        console.log("Carregando VMs...");
        const resp = await fetch('/api/vm/containers');
        const vms = await resp.json();
        console.log("VMs recebidas:", vms);
        const listDiv = document.getElementById('vm-list');
        
        if (vms.length === 0) {
            listDiv.innerHTML = '<p style="text-align: center; color: #888;">Nenhuma VM em execução.</p>';
            return;
        }
        
        let html = '';
        vms.forEach(vm => {
            const statusClass = vm.status === 'running' ? 'status-running' : 'status-exited';
            html += `<div class="vm-row">
                <div><strong>${vm.name}</strong><br><small style="color:#888;">${vm.image}</small></div>
                <div class="${statusClass}">● ${vm.status}</div>
                <div>
                    ${vm.status === 'running' ? `<button class="btn" style="background: #00bcd4; color: white; margin-right: 5px;" onclick="openTerminal('${vm.id}', '${vm.name}')">💻 Terminal</button>` : ''}
                    <button class="btn ${vm.status === 'running' ? 'btn-danger' : 'btn-primary'}" 
                        onclick="${vm.status === 'running' ? 'stopVM' : 'startVMById'}('${vm.id}')">
                        ${vm.status === 'running' ? '⏹ Parar' : '▶ Iniciar'}
                    </button>
                </div>
            </div>`;
        });
        listDiv.innerHTML = html;
    } catch (e) {
        document.getElementById('vm-list').innerHTML = '<p style="color: #f44336;">Erro ao carregar</p>';
    }
}

async function stopVM(id) {
    if (!confirm('Parar esta VM?')) return;
    try {
        const resp = await fetch('/api/vm/stop/' + id, { method: 'POST' });
        const data = await resp.json();
        if (data.success) {
            loadVMs();
        } else {
            alert("Erro ao parar: " + (data.error || "Desconhecido"));
            loadVMs();
        }
    } catch (e) {
        alert("Erro de conexão: " + e.message);
    }
}

async function startVMById(id) {
    console.log("Iniciando container:", id);
    const listDiv = document.getElementById('vm-list');
    listDiv.innerHTML = '<p style="text-align: center; color: #0db7ed;">⏳ Iniciando container...</p>';
    
    try {
        const resp = await fetch('/api/vm/start/' + id, { method: 'POST' });
        const data = await resp.json();
        
        if (data.success) {
            console.log("✅ Container iniciado:", data.message);
            loadVMs();
        } else {
            alert("Erro ao iniciar: " + (data.error || "Desconhecido"));
            loadVMs();
        }
    } catch (e) {
        console.error("Erro ao iniciar container:", e);
        alert("Erro de conexão: " + e.message);
        loadVMs();
    }
}

// === TERMINAL WEB ===
let terminal = null;
let socket = null;
let currentContainerId = null;

// === TERMINAL WEB MELHORADO V4.1 ===
let commandHistory = [];
let historyIndex = -1;
let currentLine = '';
let autocompleteSuggestions = [];

function openTerminal(containerId, containerName) {
    console.log("Abrindo terminal melhorado para:", containerId, containerName);
    currentContainerId = containerId;
    document.getElementById('terminal-container-name').textContent = containerName;
    document.getElementById('terminal-modal').classList.add('active');
    document.getElementById('terminal-overlay').classList.add('active');
    
    // Aguardar o modal ficar visível antes de inicializar
    setTimeout(() => {
    if (!terminal) {
        terminal = new Terminal({
            cursorBlink: true,
            fontSize: 14,
            fontFamily: '"Courier New", Courier, monospace',
            theme: {
                background: '#000000',
                foreground: '#00ff00',
                cursor: '#00ff00',
                cursorAccent: '#000000',
                selection: 'rgba(0, 255, 0, 0.3)',
                black: '#000000',
                red: '#ff5555',
                green: '#50fa7b',
                yellow: '#f1fa8c',
                blue: '#bd93f9',
                magenta: '#ff79c6',
                cyan: '#8be9fd',
                white: '#bbbbbb',
                brightBlack: '#555555',
                brightRed: '#ff6e67',
                brightGreen: '#69ff94',
                brightYellow: '#ffffa5',
                brightBlue: '#d6acff',
                brightMagenta: '#ff92df',
                brightCyan: '#a4ffff',
                brightWhite: '#ffffff'
            },
            scrollback: 10000,
            tabStopWidth: 4
        });
        
        window.fitAddon = new FitAddon.FitAddon();
        terminal.loadAddon(fitAddon);
        terminal.open(document.getElementById('terminal-container'));
        
        // Ajustar tamanho inicial e em resize
        setTimeout(() => {
            fitAddon.fit();
            console.log("Terminal ajustado");
        }, 100);
        
        window.addEventListener('resize', () => {
            fitAddon.fit();
        });
        
        // Capturar teclas com histórico e autocomplete
        terminal.onKey(e => {
            const ev = e.domEvent;
            const key = ev.key;
            
            if (key === 'Enter') {
                // Enviar comando
                terminal.write('\r\n');
                if (currentLine.trim()) {
                    // Adicionar ao histórico
                    if (commandHistory.length === 0 || commandHistory[commandHistory.length - 1] !== currentLine) {
                        commandHistory.push(currentLine);
                    }
                    if (commandHistory.length > 100) commandHistory.shift();
                    historyIndex = -1;
                    
                    // Enviar para servidor
                    console.log("Enviando comando:", currentLine);
                    if (socket && socket.connected) {
                        socket.emit('terminal_input', { 
                            container_id: currentContainerId, 
                            command: currentLine 
                        });
                    }
                }
                currentLine = '';
            } else if (key === 'ArrowUp') {
                // Histórico anterior
                if (historyIndex < commandHistory.length - 1) {
                    historyIndex++;
                    currentLine = commandHistory[commandHistory.length - 1 - historyIndex];
                    // Limpar linha atual e escrever nova
                    terminal.write('\r\x1b[K');
                    terminal.write('# ' + currentLine);
                }
            } else if (key === 'ArrowDown') {
                // Histórico próximo
                if (historyIndex > -1) {
                    historyIndex--;
                    currentLine = historyIndex === -1 ? '' : commandHistory[commandHistory.length - 1 - historyIndex];
                    terminal.write('\r\x1b[K');
                    terminal.write('# ' + currentLine);
                }
            } else if (key === 'Tab') {
                // Autocomplete (simplificado)
                ev.preventDefault();
                if (currentLine.trim()) {
                    // Comandos comuns para autocomplete
                    const commonCommands = ['ls', 'cd', 'pwd', 'cat', 'echo', 'mkdir', 'rm', 'cp', 'mv', 'grep', 'find', 'chmod', 'chown', 'ps', 'top', 'free', 'df', 'du', 'whoami', 'uname', 'apk', 'apt', 'yum'];
                    const matches = commonCommands.filter(cmd => cmd.startsWith(currentLine.trim()));
                    if (matches.length === 1) {
                        currentLine = matches[0] + ' ';
                        terminal.write('\x1b[K ' + matches[0].substring(currentLine.length) + ' ');
                    } else if (matches.length > 1) {
                        terminal.write('\r\n');
                        matches.forEach(m => terminal.write(m + '  '));
                        terminal.write('\r\n# ' + currentLine);
                    }
                }
            } else if (key === 'Backspace') {
                if (currentLine.length > 0) {
                    currentLine = currentLine.slice(0, -1);
                    terminal.write('\b \b');
                }
            } else if (key === 'c' && ev.ctrlKey) {
                // Ctrl+C - cancelar
                terminal.write('^C\r\n# ');
                currentLine = '';
            } else if (key === 'l' && ev.ctrlKey) {
                // Ctrl+L - limpar tela
                terminal.clear();
                terminal.write('# ');
            } else if (key.length === 1 && !ev.ctrlKey && !ev.altKey) {
                currentLine += key;
                terminal.write(key);
            }
        });
    }
    
    // Conectar Socket.IO
    socket = io();
    
    socket.on('connect', () => {
        console.log("Socket.IO conectado");
        terminal.write('\r\n\x1b[32m╔════════════════════════════════════════╗\r\n');
        terminal.write('\x1b[32m║  Conectado ao container ' + containerId.padEnd(20, ' ') + '  ║\r\n');
        terminal.write('\x1b[32m╚════════════════════════════════════════╝\r\n\x1b[0m');
        terminal.write('\x1b[33mDigite \x1b[36mhelp\x1b[33m para ver comandos disponíveis\r\n\r\n');
        terminal.write('# ');
    });
    
    socket.on('terminal_output', (data) => {
        console.log("Recebido:", data.output);
        terminal.write(data.output);
        if (!data.output.endsWith('\n')) {
            terminal.write('\r\n# ');
        } else {
            terminal.write('# ');
        }
    });
    
    socket.on('disconnect', () => {
        terminal.write('\r\n\x1b[31m\n[Conexão perdida com o container]\x1b[0m\r\n');
    });
    
    // Chamar refit após tudo estar pronto
    refitTerminal();
    }, 100); // fim do setTimeout
}

function closeTerminal() {
    console.log("Fechando terminal");
    if (socket) {
        socket.disconnect();
        socket = null;
    }
    if (terminal) {
        terminal.dispose();
        terminal = null;
    }
    document.getElementById('terminal-modal').classList.remove('active');
    document.getElementById('terminal-overlay').classList.remove('active');
}

