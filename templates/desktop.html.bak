<script>
// Relógio em tempo real
function updateClock() {
    const now = new Date();
    const hours = String(now.getHours()).padStart(2, '0');
    const minutes = String(now.getMinutes()).padStart(2, '0');
    const seconds = String(now.getSeconds()).padStart(2, '0');
    const clock = document.getElementById('clock');
    if (clock) {
        clock.textContent = hours + ':' + minutes + ':' + seconds;
    }
}
setInterval(updateClock, 1000);
updateClock();

// Função para re-ajustar o terminal quando o modal abre
function refitTerminal() {
    if (terminal && typeof fitAddon !== 'undefined' && fitAddon) {
        setTimeout(() => {
            try {
                fitAddon.fit();
                console.log("Terminal redimensionado:", terminal.cols, "x", terminal.rows);
            } catch (e) {
                console.error("Erro ao redimensionar:", e);
            }
        }, 300);
    }
}

</script>
