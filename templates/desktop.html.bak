<script>
// Injetar Card Dashboard Dinamicamente
document.addEventListener('DOMContentLoaded', () => {
    // Procurar a grid de cards principal
    const grid = document.querySelector('.cards-grid') || document.querySelector('.grid') || document.querySelector('#app-grid');
    
    if (grid) {
        const dashCard = document.createElement('div');
        dashCard.className = 'card';
        dashCard.style.cursor = 'pointer';
        dashCard.style.border = '1px solid #00ff00';
        dashCard.onclick = () => window.location.href = '/dashboard';
        
        dashCard.innerHTML = `
            <div class="card-icon" style="font-size: 24px; margin-bottom: 10px;"></div>
            <h3 style="margin: 0 0 5px 0; color: #00ff00;">Métricas</h3>
        `;
        
        grid.appendChild(dashCard);
        console.log("✅ Card Dashboard injetado via JS");
    } else {
        console.warn("⚠️ Grid de cards não encontrada para injetar Dashboard");
    }
});
</script>





<script>
document.addEventListener('DOMContentLoaded', () => {
    setTimeout(() => {
        // Estratégia melhorada: procurar pelo container que tem MÚLTIPLOS cards diretos filhos
        // Isso evita pegar containers internos de cards específicos
        let bestContainer = null;
        let maxDirectCards = 0;
        
        const allDivs = document.querySelectorAll('div');
        for (const div of allDivs) {
            // Contar apenas cards que são filhos DIRETOS desta div
            let directCardCount = 0;
            for (const child of div.children) {
                if (child.classList.contains('card')) {
                    directCardCount++;
                }
            }
            
            // Se esta div tem mais cards diretos que a anterior, e tem pelo menos 4 (grid real)
            if (directCardCount > maxDirectCards && directCardCount >= 4) {
                maxDirectCards = directCardCount;
                bestContainer = div;
            }
        }
        
        // Fallback: se não achou grid perfeita, usa o body ou main
        if (!bestContainer) {
            bestContainer = document.querySelector('main') || document.body;
            console.warn("⚠️ Grid não encontrada, usando fallback");
        }
        
        if (bestContainer && !document.getElementById('browser-injected-card')) {
            const browserCard = document.createElement('div');
            browserCard.id = 'browser-injected-card';
            browserCard.className = 'card';
            browserCard.style.cursor = 'pointer';
            browserCard.style.border = '1px solid #00ffff';
            browserCard.onclick = () => window.location.href = '/browser';
            
            browserCard.innerHTML = `
                <div class="card-header">
                    <div class="card-title">🌐 Browser</div>
                    <div></div>
                </div>
                <div class="card-category">NAVEGAÇÃO</div>
                <div class="card-desc">Navegue na web com proteção inteligente.</div>
            `;
            
            bestContainer.appendChild(browserCard);
            console.log("✅ Browser injetado em:", bestContainer.className || bestContainer.id, `(com ${maxDirectCards} cards)`);
        }
    }, 800);
});
</script>


<script>
document.addEventListener('DOMContentLoaded', () => {
    setTimeout(() => {
        // Encontrar o container principal da grid (mesma lógica do Browser)
        let bestContainer = null;
        let maxDirectCards = 0;
        
        const allDivs = document.querySelectorAll('div');
        for (const div of allDivs) {
            let directCardCount = 0;
            for (const child of div.children) {
                if (child.classList.contains('card')) {
                    directCardCount++;
                }
            }
            if (directCardCount > maxDirectCards && directCardCount >= 4) {
                maxDirectCards = directCardCount;
                bestContainer = div;
            }
        }
        
        if (!bestContainer) bestContainer = document.querySelector('main') || document.body;
        
        // Injetar Card Métricas se não existir
        if (bestContainer && !document.getElementById('metrics-injected-card')) {
            const metricsCard = document.createElement('div');
            metricsCard.id = 'metrics-injected-card';
            metricsCard.className = 'card';
            metricsCard.style.cursor = 'pointer';
            metricsCard.style.border = '1px solid #00ff00';
            metricsCard.onclick = () => window.location.href = '/dashboard';
            
            metricsCard.innerHTML = `
                <div class="card-header">
                    <div class="card-title"> Métricas</div>
                    <div></div>
                </div>
                <div class="card-category">SISTEMA</div>
                <div class="card-desc">Monitorar uso de tokens e assistentes.</div>
            `;
            
            bestContainer.appendChild(metricsCard);
            console.log("✅ Card Métricas injetado via JS");
        }
    }, 800);
});
</script>


<script>
document.addEventListener('DOMContentLoaded', () => {
    setTimeout(() => {
        // Procurar o container do Dock (barra inferior)
        const dock = document.querySelector('.dock') || 
                     document.querySelector('[class*="dock"]') || 
                     document.querySelector('nav') ||
                     document.body.querySelector('div:last-child');
        
        if (dock && !document.getElementById('dock-terminal-btn')) {
            const termBtn = document.createElement('div');
            termBtn.id = 'dock-terminal-btn';
            termBtn.className = 'dock-item'; // Usa a mesma classe dos outros itens
            termBtn.style.cursor = 'pointer';
            termBtn.style.textAlign = 'center';
            termBtn.style.padding = '5px 10px';
            termBtn.onclick = () => window.open('/terminal-native', '_blank');
            
            termBtn.innerHTML = `
                <div style="font-size: 24px;">🐧</div>
                <div style="font-size: 10px; margin-top: 2px;">Terminal</div>
            `;
            
            // Inserir antes do botão "Novo" (+) ou no final
            const novoBtn = Array.from(dock.children).find(el => el.textContent.includes('Novo') || el.innerHTML.includes('+'));
            if (novoBtn) {
                dock.insertBefore(termBtn, novoBtn);
            } else {
                dock.appendChild(termBtn);
            }
            
            console.log("✅ Botão Terminal injetado no Dock");
        }
    }, 1000);
});
</script>


<script>
