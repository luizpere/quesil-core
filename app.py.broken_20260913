@app.route('/api/file/read', methods=['GET'])
def api_read_file():
    filename = request.args.get('file', '')
    if '..' in filename or filename.startswith('/'):
        return jsonify({'error': 'Acesso negado'}), 403
    
    filepath = os.path.join(os.path.dirname(__file__), filename)
    if not os.path.exists(filepath):
        return jsonify({'error': 'Arquivo não encontrado'}), 404
        
    try:
        with open(filepath, 'r', encoding='utf-8') as f:
            return jsonify({'content': f.read(), 'filename': filename})
    except Exception as e:
        return jsonify({'error': str(e)}), 500

@app.route('/api/file/save', methods=['POST'])
def api_save_file():
    data = request.json
    filename = data.get('file', '')
    new_content = data.get('content', '')
    
    if '..' in filename or filename.startswith('/'):
        return jsonify({'error': 'Acesso negado'}), 403
        
    filepath = os.path.join(os.path.dirname(__file__), filename)
    
    # Criar backup automático antes de salvar
    if os.path.exists(filepath):
        import shutil
        shutil.copy2(filepath, filepath + '.bak')
        
    try:
        with open(filepath, 'w', encoding='utf-8') as f:
            f.write(new_content)
        return jsonify({'success': True, 'message': f'{filename} salvo com backup!'})
    except Exception as e:
        return jsonify({'error': str(e)}), 500


import threading, time

@socketio.on('request_logs')
def handle_log_request():
    """Envia histórico recente de logs ao conectar."""
    try:
        log_file = os.path.join(os.path.dirname(__file__), 'app.log')
        if os.path.exists(log_file):
            with open(log_file, 'r', encoding='utf-8', errors='replace') as f:
                lines = f.readlines()[-50:] # Últimas 50 linhas
                emit('log_update', ''.join(lines))
    except Exception as e:
        emit('log_update', f'Erro ao ler logs: {e}\n')

def tail_log_file():
    """Thread em background que monitora app.log e envia novas linhas."""
    log_file = os.path.join(os.path.dirname(__file__), 'app.log')
    
    # Aguardar arquivo existir
    while not os.path.exists(log_file):
        time.sleep(1)
        
    with open(log_file, 'r', encoding='utf-8', errors='replace') as f:
        f.seek(0, 2) # Ir para o final do arquivo
        
        while True:
            line = f.readline()
            if line:
                socketio.emit('log_update', line)
            else:
                time.sleep(0.5) # Esperar se não houver novas linhas

# Iniciar thread de monitoramento de logs
log_thread = threading.Thread(target=tail_log_file, daemon=True)
log_thread.start()



@app.route('/api/git/status', methods=['GET'])
@app.route('/api/git/status', methods=['GET'])
def api_git_status():
    try:
        import subprocess
        result = subprocess.run(['git', 'status', '--porcelain'], 
                              capture_output=True, text=True, cwd=os.path.dirname(__file__))
        files = []
        for line in result.stdout.strip().split('\n'):
            if line:
                status = line[:2].strip()
                filename = line[3:].strip()
                files.append({'status': status, 'file': filename})
        return jsonify({'success': True, 'files': files})
    except Exception as e:
        import traceback
        traceback.print_exc()
        return jsonify({'success': False, 'error': str(e)}), 500


@app.route('/api/git/commit', methods=['POST'])
def api_git_commit():
    try:
        import subprocess
        
        # Validar entrada
        data = request.get_json(force=True, silent=True)
        if not data or 'message' not in data:
            return jsonify({'success': False, 'error': 'Dados inválidos'}), 400
        
        message = data['message'].strip()
        if not message:
            return jsonify({'success': False, 'error': 'Mensagem vazia'}), 400
        
        project_dir = os.path.dirname(__file__)
        
        # Verificar se git está configurado
        config_check = subprocess.run(['git', 'config', 'user.name'], 
                                     capture_output=True, text=True, cwd=project_dir)
        if not config_check.stdout.strip():
            subprocess.run(['git', 'config', 'user.name', 'Luperesil'], cwd=project_dir)
            subprocess.run(['git', 'config', 'user.email', 'luperesil@thinkinos.local'], cwd=project_dir)
        
        # Git add
        add_result = subprocess.run(['git', 'add', '.'], 
                                   capture_output=True, text=True, cwd=project_dir)
        if add_result.returncode != 0:
            return jsonify({'success': False, 'error': f'git add falhou: {add_result.stderr}'}), 500
        
        # Git commit
        commit_result = subprocess.run(['git', 'commit', '-m', message], 
                                      capture_output=True, text=True, cwd=project_dir)
        
        if commit_result.returncode == 0:
            return jsonify({'success': True, 'output': commit_result.stdout})
        else:
            # Se não há mudanças para commitar, considerar sucesso
            if 'nothing to commit' in commit_result.stdout.lower():
                return jsonify({'success': True, 'output': 'Nenhuma alteração pendente.'})
            else:
                return jsonify({'success': False, 'error': commit_result.stderr}), 500
                
    except Exception as e:
        import traceback
        traceback.print_exc()
        return jsonify({'success': False, 'error': str(e)}), 500

