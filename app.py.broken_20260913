def handle_terminal_connect():
    global term_master_fd, term_pid
    try:
        term_pid, term_master_fd = pty.fork()
        if term_pid == 0:
            # Processo filho: shell interativo
            os.environ['TERM'] = 'xterm-256color'
            os.execvp('bash', ['bash', '-i'])
        else:
            # Processo pai: envia mensagem inicial
            emit('output', '\r\n ThinkinOS Shell Conectado\r\nluperesil@thinkinos:~$ ')
    except Exception as e:
        emit('output', f'\r\nErro ao iniciar shell: {str(e)}\r\n')

@socketio.on('input')
def handle_terminal_input(data):
    global term_master_fd
    if term_master_fd:
        try:
            os.write(term_master_fd, data.encode())
        except OSError:
            pass

# LOOP DE POLLING PARA LER OUTPUT DO SHELL
def poll_terminal_output():
    """Verifica periodicamente se há output no shell e envia via WebSocket."""
    global term_master_fd
    while True:
        if term_master_fd:
            try:
                # Verificar se há dados disponíveis para leitura (não bloqueante)
                ready, _, _ = select.select([term_master_fd], [], [], 0.1)
                if ready:
                    data = os.read(term_master_fd, 1024)
                    if data:
                        text = data.decode('utf-8', errors='replace')
                        # Enviar para todos os clientes conectados (simplificação segura)
                        socketio.emit('output', text)
                    else:
                        # Shell fechou
                        term_master_fd = None
            except OSError:
                term_master_fd = None
            except Exception as e:
                print(f"Erro polling terminal: {e}")
                term_master_fd = None
        else:
            import time; time.sleep(1)

# Iniciar loop de polling em background quando o app iniciar
import threading
poll_thread = threading.Thread(target=poll_terminal_output, daemon=True)
poll_thread.start()

@socketio.on('disconnect')
def handle_terminal_disconnect():
    global term_master_fd, term_pid
    if term_pid:
        try: os.kill(term_pid, 9)
        except: pass
    if term_master_fd:
        try: os.close(term_master_fd)
        except: pass
    term_master_fd = None
    term_pid = None


